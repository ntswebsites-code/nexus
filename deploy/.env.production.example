# Copy to /opt/matanho-nexus/.env.production on the server (chmod 600).
# Placeholders only - NEVER commit real values.

# --- MySQL container ---
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=matanho_nexus
MYSQL_USER=matanho_app
MYSQL_PASSWORD=CHANGE_ME

# --- API ---
NODE_ENV=production
API_PORT=4100
API_HOST=0.0.0.0
DATABASE_URL=mysql://matanho_app:CHANGE_ME@mysql:3306/matanho_nexus
# Not used by `migrate deploy`, but the Prisma schema references it.
SHADOW_DATABASE_URL=mysql://matanho_app:CHANGE_ME@mysql:3306/matanho_nexus_shadow

ADMIN_PORTAL_URL=https://nexus.matanho.com
INVESTOR_PORTAL_URL=https://investor.nexus.matanho.com
ONBOARDING_PORTAL_URL=https://onboarding.nexus.matanho.com
COMPANY_PORTAL_URL=https://company.nexus.matanho.com
CUSTODIAN_PORTAL_URL=https://custodian.nexus.matanho.com
CORS_ORIGINS=https://nexus.matanho.com,https://investor.nexus.matanho.com,https://onboarding.nexus.matanho.com,https://company.nexus.matanho.com,https://custodian.nexus.matanho.com

# --- Runtime flags (DEV-PLAN 7) ---
# Rollback = change the value and `docker compose ... up -d --no-deps api` (or deploy/rollback.sh --flags-off).
# LP domains switched to live data, comma list of:
#   session,dashboard,capital,activity,dealing,performance,documents,notices,requests,organisation,settings,reports
#   ("all" = every domain). Flip a domain only when tools/uat/contract-harness.ts reports it PASS.
LP_LIVE_DOMAINS=
# Investee portal actions allowed to call the live API (comma list; empty = demo only).
INVESTEE_LIVE_ACTIONS=
# true/false: custodian day-end submissions and public onboarding call the live API.
CUSTODIAN_LIVE=false
ONBOARDING_LIVE=false

SESSION_COOKIE_NAME=nexus_session
SESSION_TTL_HOURS=12
COOKIE_DOMAIN=.nexus.matanho.com
BCRYPT_ROUNDS=12
ALLOW_SELF_REGISTRATION=false
# Ceiling for the admin session-timeout policy (Settings > RBAC; default 30 minutes).
SESSION_IDLE_MINUTES=240
PUBLIC_API_URL=https://api.nexus.matanho.com

# --- Files (encrypted at rest) ---
# 32 random bytes, e.g. `openssl rand -base64 32`. Losing it makes stored files unreadable.
FILE_ENCRYPTION_KEY=CHANGE_ME
# e.g. `openssl rand -hex 32`
DOWNLOAD_SIGNING_SECRET=CHANGE_ME
MAX_UPLOAD_MB=25

# --- Email (leave SMTP_HOST empty to log emails to the worker console) ---
# UAT: every email goes to the Mailpit container (DEV-PLAN D9); no real email is sent.
#   SMTP_HOST=mailpit  SMTP_PORT=1025  SMTP_SECURE=false  SMTP_USER/SMTP_PASSWORD empty
# Production: a real relay, e.g. SMTP_PORT=587 (STARTTLS) or 465 with SMTP_SECURE=true.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Matanho Nexus <no-reply@nexus.matanho.com>
# Host port for the Mailpit web UI/API, bound to 127.0.0.1 only (read by compose interpolation
# from deploy/.env or the shell, default 8625). Reach it with an SSH tunnel.
# MAILPIT_UI_PORT=8625

# --- Seed ---
# 1 = load the V56 prototype demo client (CL-00418) and company (PC-100) once.
SEED_DEMO=0
# Demo records link to these existing users when present.
SEED_DEMO_INVESTOR_EMAIL=investor.admin@nexus.matanho.com
SEED_DEMO_COMPANY_EMAIL=company@nexus.matanho.com
# UAT personas and data (prisma/seed-uat.ts) are NOT driven from this file: deploy.sh runs the
# seed only when called with SEED_UAT=1, using ../secrets/users.json (SEED_USERS_FILE, mounted
# into the migrate container) for credentials. Optional for that run: SEED_UAT_MFA_REQUIRED=1.

# --- Portals ---
NEXT_PUBLIC_API_URL=https://api.nexus.matanho.com
API_INTERNAL_URL=http://api:4100
# The onboarding portal is public (applicants have no account yet; drafts use magic links).
REQUIRE_AUTH_PORTALS=admin,investor,company

# --- Object storage (MinIO) ---
# Generate every value below ON THE SERVER (openssl rand -hex 24); never commit real values.
# local = encrypted files on the file-storage volume (default); s3 = MinIO. Flip to s3 only after
# `npx tsx scripts/migrate-storage-to-s3.ts --dry-run` and the real run in backend/api.
INTEGRATION_OBJECT_STORAGE=local
# Root credentials, used only by the minio and minio-init services.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Least-privilege app user created by minio-init, scoped to the three buckets.
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_BUCKET_DOCUMENTS=nexus-documents
STORAGE_S3_BUCKET_ESIGN=nexus-esign
STORAGE_S3_BUCKET_EXPORTS=nexus-exports
# MinIO console on 127.0.0.1 only (SSH tunnel): MINIO_CONSOLE_PORT=19101
