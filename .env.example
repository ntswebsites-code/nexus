# ---------------------------------------------------------------------------
# Matanho Nexus - environment configuration
# Copy to `.env` at the repository root and fill in the values.
# `.env` is git-ignored. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# --- Shared Express API ----------------------------------------------------
NODE_ENV=development
API_PORT=4100
API_HOST=0.0.0.0

# MySQL connection used by Prisma (backend only - portals never see this).
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://matanho_app:CHANGE_ME@127.0.0.1:3306/matanho_nexus"
# Prisma migrate needs a scratch database it can create/drop tables in (dev only).
SHADOW_DATABASE_URL="mysql://matanho_app:CHANGE_ME@127.0.0.1:3306/matanho_nexus_shadow"

# --- Portal origins (each portal is its own Next.js app) -------------------
ADMIN_PORTAL_URL=http://localhost:3100
INVESTOR_PORTAL_URL=http://localhost:3101
ONBOARDING_PORTAL_URL=http://localhost:3102
COMPANY_PORTAL_URL=http://localhost:3103

# Comma separated list of origins allowed by CORS (credentials are enabled).
# Leave empty to default to the four portal URLs above.
CORS_ORIGINS=

# --- Authentication --------------------------------------------------------
SESSION_COOKIE_NAME=nexus_session
# Session lifetime in hours.
SESSION_TTL_HOURS=12
# Optional. Set to a parent domain (e.g. .matanho.com) in production so all
# portals share one login session. Leave empty for localhost.
COOKIE_DOMAIN=
# bcrypt cost factor.
BCRYPT_ROUNDS=12

# Allow POST /api/auth/register. Defaults to true in development, false in production.
ALLOW_SELF_REGISTRATION=

# --- Portals (read by Next.js; only NEXT_PUBLIC_* is exposed to the browser)
NEXT_PUBLIC_API_URL=http://localhost:4100
# Comma separated portals that must be signed in to open (redirects to /login).
# Empty = every portal opens without an account (UI-mockup mode).
# Valid values: admin, investor, onboarding, company
REQUIRE_AUTH_PORTALS=

# --- Optional first user for `npm run db:seed` (never commit real values) ---
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_NAME=
# Comma list of "<portal>:<roleKey>", e.g. admin:system_admin,investor:admin
SEED_USER_ROLES=admin:system_admin

# --- Integrations (WP-8): one flag per external adapter, fake or live ---
# fake = built-in simulator that persists to integration_calls / integration_inbox; live = real vendor (needs its
# credentials, otherwise the API and worker refuse to start). In production `fake` is refused unless
# ALLOW_FAKE_INTEGRATIONS=1 (email over SMTP, local encrypted file storage and the deterministic Copilot are exempt).
# Keep this at 1 until vendors are chosen (DECISIONS-NEEDED); the /ops/integrations screen shows what is still fake.
ALLOW_FAKE_INTEGRATIONS=0
# live: SMTP relay (SMTP_HOST above; SES/SendGrid client to follow)
INTEGRATION_EMAIL=fake
# live: SMS_API_KEY, SMS_SENDER_ID
INTEGRATION_SMS=fake
# live: SCREENING_API_URL, SCREENING_API_KEY
INTEGRATION_SCREENING=fake
# live: IDV_API_URL, IDV_API_KEY
INTEGRATION_IDENTITY_VERIFICATION=fake
# live: MARKET_DATA_API_URL, MARKET_DATA_API_KEY
INTEGRATION_MARKET_DATA=fake
# live: CUSTODIAN_FEED_HOST, CUSTODIAN_FEED_USER, CUSTODIAN_FEED_KEY
INTEGRATION_CUSTODIAN_FEED=fake
# live: BANK_STATEMENT_HOST, BANK_STATEMENT_USER, BANK_STATEMENT_KEY
INTEGRATION_BANK_STATEMENT=fake
# live: PAYMENT_API_URL, PAYMENT_API_KEY
INTEGRATION_PAYMENT=fake
# live: ESIGN_API_URL, ESIGN_API_KEY
INTEGRATION_ESIGN=fake
# live: AV_SCAN_HOST (clamd)
INTEGRATION_AV_SCAN=fake
# live: LLM_API_KEY, LLM_MODEL
INTEGRATION_LLM=fake
# live: SSO_ISSUER_URL, SSO_CLIENT_ID, SSO_CLIENT_SECRET (fake IdP page is dev only)
INTEGRATION_SSO=fake
# live: S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY, S3_SECRET_KEY
INTEGRATION_OBJECT_STORAGE=fake
# live: REGULATOR_API_URL, REGULATOR_API_KEY
INTEGRATION_REGULATOR_FILING=fake
# live: BROKER_FIX_HOST, BROKER_FIX_SENDER_ID, BROKER_FIX_TARGET_ID
INTEGRATION_BROKER_ROUTING=fake
=======
# Object storage: local (default, files under STORAGE_DIR) | s3 (MinIO/S3) | fake (tests)
# INTEGRATION_OBJECT_STORAGE=local
# STORAGE_S3_ENDPOINT=http://localhost:9000
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_BUCKET_DOCUMENTS=nexus-documents
# STORAGE_S3_BUCKET_ESIGN=nexus-esign
# STORAGE_S3_BUCKET_EXPORTS=nexus-exports
=======
# Integrations (adapters). Defaults are safe: nothing external is contacted unless you opt in.
# Market data: public (free ZSE/FX pages, polite and cached) | fake (deterministic test data) | live (paid feed, not configured)
INTEGRATION_MARKET_DATA=fake
# Worker price refresh on exchange hours; defaults to on only when INTEGRATION_MARKET_DATA=public
MARKET_DATA_SCHEDULER=
# Custodian statements: file-drop (admin upload) | fake | live (SWIFT/API, not configured)
INTEGRATION_CUSTODIAN_FEED=file-drop
