/// Native e-signature request on one PDF (INTEGRATION_ESIGN=native). Immutable once COMPLETED:
/// the sealed file, its SHA-256 and the signature hash chain head are final.
model EsignRequest {
  id                String    @id @default(uuid()) @db.Char(36)
  ref               String    @unique @db.VarChar(16)
  title             String    @db.VarChar(200)
  message           String?   @db.VarChar(2000)
  /// Optional link to the document store; the sealed copy is added as a new DocumentVersion.
  documentId        String?   @map("document_id") @db.Char(36)
  /// The PDF being signed (a FileObject, never changed after creation).
  fileId            String    @map("file_id") @db.Char(36)
  originalSha256    String    @map("original_sha256") @db.Char(64)
  sealedFileId      String?   @map("sealed_file_id") @db.Char(36)
  sealedSha256      String?   @map("sealed_sha256") @db.Char(64)
  certificateFileId String?   @map("certificate_file_id") @db.Char(36)
  /// DRAFT | PENDING | COMPLETED | DECLINED | VOIDED | EXPIRED
  status            String    @default("DRAFT") @db.VarChar(16)
  /// SEQUENTIAL | PARALLEL
  signingOrder      String    @default("PARALLEL") @map("signing_order") @db.VarChar(12)
  /// Business subject, e.g. COMMITMENT / CAPITAL_CALL_ALLOCATION / DOCUMENT.
  subjectType       String?   @map("subject_type") @db.VarChar(40)
  subjectId         String?   @map("subject_id") @db.VarChar(64)
  clientId          String?   @map("client_id") @db.Char(36)
  companyId         String?   @map("company_id") @db.Char(36)
  /// Running SHA-256 chain over the signatures collected so far (genesis = ref + original hash).
  chainHead         String?   @map("chain_head") @db.Char(64)
  expiresAt         DateTime? @map("expires_at")
  sentAt            DateTime? @map("sent_at")
  completedAt       DateTime? @map("completed_at")
  voidedAt          DateTime? @map("voided_at")
  voidReason        String?   @map("void_reason") @db.VarChar(500)
  declineReason     String?   @map("decline_reason") @db.VarChar(500)
  createdById       String?   @map("created_by_id") @db.Char(36)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  version           Int       @default(1)

  signers EsignSigner[]
  events  EsignEvent[]

  @@index([status, expiresAt])
  @@index([subjectType, subjectId])
  @@index([clientId])
  @@index([companyId])
  @@index([documentId])
  @@map("esign_requests")
}

model EsignSigner {
  id                 String    @id @default(uuid()) @db.Char(36)
  requestId          String    @map("request_id") @db.Char(36)
  orderNo            Int       @default(1) @map("order_no")
  /// STAFF | LP | INVESTEE | EXTERNAL
  kind               String    @db.VarChar(12)
  userId             String?   @map("user_id") @db.Char(36)
  name               String    @db.VarChar(120)
  email              String    @db.VarChar(254)
  /// Capacity / authority shown on the signature block.
  roleLabel          String?   @map("role_label") @db.VarChar(160)
  /// WAITING | PENDING | SIGNED | DECLINED | VOIDED
  status             String    @default("WAITING") @db.VarChar(12)
  /// SHA-256 of the one-time link token (external signers); cleared once used.
  tokenHash          String?   @unique @map("token_hash") @db.Char(64)
  tokenExpiresAt     DateTime? @map("token_expires_at")
  otpHash            String?   @map("otp_hash") @db.Char(64)
  otpExpiresAt       DateTime? @map("otp_expires_at")
  otpAttempts        Int       @default(0) @map("otp_attempts")
  /// SESSION | EMAIL_OTP
  identityMethod     String?   @map("identity_method") @db.VarChar(16)
  identityVerifiedAt DateTime? @map("identity_verified_at")
  mfaAt              DateTime? @map("mfa_at")
  notifiedAt         DateTime? @map("notified_at")
  reminderCount      Int       @default(0) @map("reminder_count")
  viewedAt           DateTime? @map("viewed_at")
  signedAt           DateTime? @map("signed_at")
  declinedAt         DateTime? @map("declined_at")
  declineReason      String?   @map("decline_reason") @db.VarChar(500)
  /// TYPED | DRAWN
  signatureMode      String?   @map("signature_mode") @db.VarChar(8)
  signatureText      String?   @map("signature_text") @db.VarChar(160)
  /// Drawn signature as a PNG data URL (max ~150 KB).
  signatureImage     String?   @map("signature_image") @db.MediumText
  signatureHash      String?   @map("signature_hash") @db.Char(64)
  ip                 String?   @db.VarChar(45)
  userAgent          String?   @map("user_agent") @db.VarChar(255)
  consentTextVersion String?   @map("consent_text_version") @db.VarChar(32)
  consentHash        String?   @map("consent_hash") @db.Char(64)
  docSha256          String?   @map("doc_sha256") @db.Char(64)
  /// Hash chain link recorded when this signer signed.
  chainHash          String?   @map("chain_hash") @db.Char(64)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  request EsignRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, email])
  @@index([userId, status])
  @@index([requestId, orderNo])
  @@map("esign_signers")
}

/// Append-only per-request event log, hash chained (prev_hash + canonical body).
model EsignEvent {
  id         BigInt   @id @default(autoincrement())
  requestId  String   @map("request_id") @db.Char(36)
  signerId   String?  @map("signer_id") @db.Char(36)
  /// CREATED SENT VIEWED OTP_SENT OTP_VERIFIED OTP_FAILED SIGNED DECLINED VOIDED REMINDED EXPIRED COMPLETED RESENT
  type       String   @db.VarChar(24)
  actorId    String?  @map("actor_id") @db.Char(36)
  ip         String?  @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  detail     Json?
  occurredAt DateTime @default(now()) @map("occurred_at")
  prevHash   String   @map("prev_hash") @db.Char(64)
  hash       String   @db.Char(64)

  request EsignRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, id])
  @@map("esign_events")
}

// ---- end ESign ----

// ---- MarketData ----
// Market-data adapter bookkeeping (public/fake/live providers) and the custodian-feed placeholder.
// Prices and FX still land in security_prices / fx_rates; these tables record where each value came from.

/// Per-source health and back-off state for the market-data providers.
model MdSourceStatus {
  id                  String    @id @default(uuid()) @db.Char(36)
  /// Short code, also used as security_prices.source, e.g. ZSE_AFX | ER_API | FAKE.
  source              String    @unique @db.VarChar(24)
  provider            String    @db.VarChar(16)
  label               String    @db.VarChar(120)
  url                 String    @db.VarChar(500)
  enabled             Boolean   @default(true)
  lastAttemptAt       DateTime? @map("last_attempt_at") @db.DateTime(3)
  lastSuccessAt       DateTime? @map("last_success_at") @db.DateTime(3)
  /// OK | PARTIAL | ERROR | BACKOFF | NOT_CONFIGURED
  lastStatus          String?   @map("last_status") @db.VarChar(16)
  lastError           String?   @map("last_error") @db.VarChar(500)
  lastCount           Int       @default(0) @map("last_count")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  backoffUntil        DateTime? @map("backoff_until") @db.DateTime(3)
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("md_source_status")
}

/// Provenance of one fetched value: which page, when, and a hash of the raw row. Accepted values point at the
/// security_prices / fx_rates row they produced; rejected or failed rows are the exception list.
model MdProvenance {
  id             String    @id @default(uuid()) @db.Char(36)
  /// sha256 of refType|source|ticker|priceDate|status|rawHash: repeats of the same observation update one row.
  keyHash        String    @unique @map("key_hash") @db.Char(64)
  /// PRICE | FX
  refType        String    @map("ref_type") @db.VarChar(8)
  /// security_prices.id or fx_rates.id (logical reference); null for rejected rows.
  refId          String?   @map("ref_id") @db.Char(36)
  securityId     String?   @map("security_id") @db.Char(36)
  /// Ticker, or FROM/TO for FX.
  ticker         String    @db.VarChar(32)
  priceDate      DateTime? @map("price_date") @db.Date
  source         String    @db.VarChar(24)
  url            String    @db.VarChar(500)
  fetchedAt      DateTime  @map("fetched_at") @db.DateTime(3)
  rawHash        String    @map("raw_hash") @db.Char(64)
  rawValue       String?   @map("raw_value") @db.VarChar(80)
  value          Decimal?  @db.Decimal(24, 10)
  previousValue  Decimal?  @map("previous_value") @db.Decimal(24, 10)
  /// ACCEPTED | REJECTED | ERROR | OVERRIDDEN (a manual price exists for the same date)
  status         String    @db.VarChar(12)
  reason         String?   @db.VarChar(300)
  seenCount      Int       @default(1) @map("seen_count")
  acknowledgedAt DateTime? @map("acknowledged_at") @db.DateTime(3)
  acknowledgedBy String?   @map("acknowledged_by") @db.Char(36)
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([refType, refId])
  @@index([securityId, fetchedAt])
  @@index([status, fetchedAt])
  @@map("md_provenance")
}

/// One refresh (scheduled or manual) across the active provider.
model MdRefreshRun {
  id          String    @id @default(uuid()) @db.Char(36)
  /// SCHEDULE | MANUAL
  trigger     String    @db.VarChar(12)
  provider    String    @db.VarChar(16)
  /// EOD | INTRADAY | FX | ALL
  scope       String    @db.VarChar(12)
  /// RUNNING | OK | PARTIAL | FAILED
  status      String    @default("RUNNING") @db.VarChar(12)
  startedAt   DateTime  @default(now()) @map("started_at") @db.DateTime(3)
  finishedAt  DateTime? @map("finished_at") @db.DateTime(3)
  requestedBy String?   @map("requested_by") @db.Char(36)
  accepted    Int       @default(0)
  rejected    Int       @default(0)
  errors      Int       @default(0)
  skipped     Int       @default(0)
  summary     Json?

  @@index([startedAt])
  @@map("md_refresh_runs")
}

/// A statement file ingested through the custodian-feed adapter (file-drop or fake).
model CustodianFeedFile {
  id             String    @id @default(uuid()) @db.Char(36)
  counterpartyId String    @map("counterparty_id") @db.Char(36)
  /// file-drop | fake | live
  adapter        String    @db.VarChar(12)
  filename       String    @db.VarChar(200)
  /// CSV | MT940 | JSON
  format         String    @db.VarChar(8)
  sha256         String    @db.Char(64)
  accountRef     String?   @map("account_ref") @db.VarChar(64)
  statementDate  DateTime? @map("statement_date") @db.Date
  currency       String?   @db.Char(3)
  closingCash    Decimal?  @map("closing_cash") @db.Decimal(20, 2)
  holdingsMv     Decimal?  @map("holdings_mv") @db.Decimal(20, 2)
  /// Imported | Failed
  status         String    @db.VarChar(12)
  tradesImported Int       @default(0) @map("trades_imported")
  tradesSkipped  Int       @default(0) @map("trades_skipped")
  holdingsCount  Int       @default(0) @map("holdings_count")
  dayEndRef      String?   @map("day_end_ref") @db.VarChar(20)
  warnings       Json?
  error          String?   @db.VarChar(500)
  uploadedBy     String?   @map("uploaded_by") @db.Char(36)
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([counterpartyId, sha256])
  @@index([counterpartyId, createdAt])
  @@map("custodian_feed_files")
}

/// Holdings lines from a custodian statement (the recon day-end package only keeps the total).
model CustodianFeedHolding {
  id             String   @id @default(uuid()) @db.Char(36)
  fileId         String   @map("file_id") @db.Char(36)
  counterpartyId String   @map("counterparty_id") @db.Char(36)
  accountRef     String   @map("account_ref") @db.VarChar(64)
  statementDate  DateTime @map("statement_date") @db.Date
  ticker         String   @db.VarChar(32)
  isin           String?  @db.VarChar(12)
  quantity       Decimal  @db.Decimal(24, 8)
  price          Decimal? @db.Decimal(20, 8)
  marketValue    Decimal? @map("market_value") @db.Decimal(20, 2)
  currency       String   @db.Char(3)
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([counterpartyId, accountRef, statementDate, ticker])
  @@index([fileId])
  @@map("custodian_feed_holdings")
}
// ---- end MarketData ----

// ---- OpsControls ----
/// Payments reconciliation run: expected distribution payouts and capital-call receipts against imported bank statement
/// lines. One row per scope (fund or all, date window); a repeat is a re-run of the same row.
model PayReconRun {
  id           String   @id @default(uuid()) @db.Char(36)
  /// PRR-00001
  ref          String   @unique @db.VarChar(16)
  /// fund id or *, from, to
  scopeKey     String   @unique @map("scope_key") @db.VarChar(120)
  fundId       String?  @map("fund_id") @db.Char(36)
  dateFrom     DateTime @map("date_from") @db.Date
  dateTo       DateTime @map("date_to") @db.Date
  /// CLEAN | BREAKS | NO_STATEMENTS
  status       String   @db.VarChar(16)
  itemCount    Int      @default(0) @map("item_count")
  matchedCount Int      @default(0) @map("matched_count")
  breakCount   Int      @default(0) @map("break_count")
  notDueCount  Int      @default(0) @map("not_due_count")
  lineCount    Int      @default(0) @map("line_count")
  params       Json?
  summary      Json?
  runCount     Int      @default(1) @map("run_count")
  runBy        String   @map("run_by") @db.Char(36)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([dateTo])
  @@map("pay_recon_runs")
}

/// An expected payment: one LP's share of an issued distribution (money out) or capital call (money in).
model PayReconItem {
  id             String    @id @default(uuid()) @db.Char(36)
  /// DISTRIBUTION_PAYOUT | CAPITAL_CALL_RECEIPT
  kind           String    @db.VarChar(24)
  /// distribution_allocations.id or capital_call_allocations.id
  sourceId       String    @map("source_id") @db.Char(36)
  fundId         String    @map("fund_id") @db.Char(36)
  documentId     String    @map("document_id") @db.Char(36)
  documentRef    String    @map("document_ref") @db.VarChar(16)
  clientId       String    @map("client_id") @db.Char(36)
  payeeName      String    @map("payee_name") @db.VarChar(255)
  /// IN | OUT
  direction      String    @db.VarChar(3)
  expectedAmount Decimal   @map("expected_amount") @db.Decimal(20, 4)
  currency       String    @db.Char(3)
  dueDate        DateTime  @map("due_date") @db.Date
  /// NOT_DUE | MATCHED | BREAK | ACCEPTED | DEFERRED
  status         String    @default("NOT_DUE") @db.VarChar(12)
  /// A statement line pairs with at most one item.
  matchedLineId  String?   @unique @map("matched_line_id") @db.Char(36)
  matchedAmount  Decimal?  @map("matched_amount") @db.Decimal(20, 4)
  /// REFERENCE | AMOUNT | MANUAL
  matchMethod    String?   @map("match_method") @db.VarChar(12)
  matchedAt      DateTime? @map("matched_at") @db.DateTime(3)
  deferredUntil  DateTime? @map("deferred_until") @db.Date
  lastRunId      String?   @map("last_run_id") @db.Char(36)
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([kind, sourceId], map: "pay_recon_item_src")
  @@index([status])
  @@index([fundId, dueDate])
  @@map("pay_recon_items")
}

/// A payments-reconciliation break. OPEN -> INVESTIGATING -> PENDING_CHECKER -> RESOLVED (independent checker), or
/// AUTO_CLEARED when a re-run finds the item paired.
model PayReconBreak {
  id             String    @id @default(uuid()) @db.Char(36)
  /// PRB-00001
  ref            String    @unique @db.VarChar(16)
  /// ITEM:<kind>:<source id> or LINE:<line id>; unique so a re-run never duplicates
  itemKey        String    @unique @map("item_key") @db.VarChar(80)
  itemId         String?   @map("item_id") @db.Char(36)
  lineId         String?   @map("line_id") @db.Char(36)
  fundId         String?   @map("fund_id") @db.Char(36)
  /// MISSING_PAYMENT | AMOUNT_DIFF | UNPAIRED_LINE
  kind           String    @db.VarChar(20)
  label          String    @db.VarChar(400)
  expected       Json?
  actual         Json?
  difference     Decimal?  @db.Decimal(20, 4)
  currency       String?   @db.Char(3)
  /// LOW | MEDIUM | HIGH | CRITICAL
  severity       String    @db.VarChar(10)
  /// OPEN | INVESTIGATING | PENDING_CHECKER | RESOLVED | AUTO_CLEARED
  status         String    @default("OPEN") @db.VarChar(16)
  ownerUserId    String?   @map("owner_user_id") @db.Char(36)
  /// MANUAL_MATCH | ACCEPT_DIFFERENCE | TIMING | RETURNED_PAYMENT
  resolution     String?   @db.VarChar(24)
  rationale      String?   @db.VarChar(1000)
  evidenceRef    String?   @map("evidence_ref") @db.VarChar(200)
  /// resolution parameters: line id for MANUAL_MATCH, date for TIMING
  resolutionData Json?     @map("resolution_data")
  makerId        String?   @map("maker_id") @db.Char(36)
  checkerId      String?   @map("checker_id") @db.Char(36)
  resolvedAt     DateTime? @map("resolved_at") @db.DateTime(3)
  lastRunId      String?   @map("last_run_id") @db.Char(36)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.DateTime(3)
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  events PayReconBreakEvent[]

  @@index([status, severity])
  @@index([fundId, status])
  @@map("pay_recon_breaks")
}

model PayReconBreakEvent {
  id         String   @id @default(uuid()) @db.Char(36)
  breakId    String   @map("break_id") @db.Char(36)
  action     String   @db.VarChar(24)
  fromStatus String?  @map("from_status") @db.VarChar(16)
  toStatus   String?  @map("to_status") @db.VarChar(16)
  actorId    String?  @map("actor_id") @db.Char(36)
  note       String?  @db.VarChar(1000)
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  break PayReconBreak @relation(fields: [breakId], references: [id], onDelete: Cascade)

  @@index([breakId, createdAt])
  @@map("pay_recon_break_events")
}
// ---- end OpsControls ----
