// Matanho Nexus - shared database schema.
//
// Identity/RBAC foundation plus the SRD Phase 1 "cross-portal core":
// onboarding & KYC, clients, documents & publications, investor services,
// portfolio-company reporting, audit, outbox and notifications.
// Conventions follow docs/SRD.md section 10.1 (UUID ids, human `ref` columns,
// audit columns, optimistic `version`, DECIMAL money + currency).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ============================================================ identity =====

/// A person who can sign in to one or more portals. One account for all portals.
model User {
  id           String    @id @default(uuid()) @db.Char(36)
  email        String    @unique @db.VarChar(254)
  /// bcrypt hash. Never selected into API responses.
  passwordHash String    @map("password_hash") @db.VarChar(100)
  name         String?   @db.VarChar(120)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions       Session[]
  roles          UserRole[]
  mfaFactors     UserMfaFactor[]
  passwordResets PasswordReset[]
  notifications  Notification[]
  clientLinks    ClientUser[]
  companyLinks   CompanyUser[]

  @@map("users")
}

/// Server-side session. The browser only holds an opaque random token in an
/// httpOnly cookie; we store its SHA-256 so a database leak cannot be replayed.
model Session {
  id            String    @id @default(uuid()) @db.Char(36)
  userId        String    @map("user_id") @db.Char(36)
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastUsedAt    DateTime  @default(now()) @map("last_used_at")
  userAgent     String?   @map("user_agent") @db.VarChar(255)
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  /// Set while a second factor is still required for this session.
  mfaPending    Boolean   @default(false) @map("mfa_pending")
  mfaVerifiedAt DateTime? @map("mfa_verified_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A role scoped to one portal, e.g. admin/compliance or investor/finance.
model Role {
  id     String  @id @default(uuid()) @db.Char(36)
  portal String  @db.VarChar(32)
  key    String  @db.VarChar(64)
  label  String  @db.VarChar(120)
  /// Locked roles (system_admin) cannot have their bundle edited.
  locked Boolean @default(false)
  custom Boolean @default(false)

  permissions RolePermission[]
  users       UserRole[]

  @@unique([portal, key])
  @@map("roles")
}

/// Permission code (e.g. "orders.approve") granted by a role.
model RolePermission {
  roleId     String @map("role_id") @db.Char(36)
  permission String @db.VarChar(80)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Char(36)
  roleId     String   @map("role_id") @db.Char(36)
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model UserMfaFactor {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @map("user_id") @db.Char(36)
  type       String    @default("totp") @db.VarChar(16)
  secretEnc  String    @map("secret_enc") @db.Text
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_mfa_factors")
}

/// Single-use invitation to a portal (investor admin, company user, staff).
model Invitation {
  id          String    @id @default(uuid()) @db.Char(36)
  email       String    @db.VarChar(254)
  name        String?   @db.VarChar(120)
  portal      String    @db.VarChar(32)
  /// Role keys within `portal` granted on acceptance.
  roleKeys    Json      @map("role_keys")
  clientId    String?   @map("client_id") @db.Char(36)
  companyId   String?   @map("company_id") @db.Char(36)
  scope       String?   @db.VarChar(32)
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")
  invitedById String?   @map("invited_by_id") @db.Char(36)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("invitations")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ============================================================ platform =====

/// Security/workflow policy toggles (order_approval, cash_approval, mfa_required ...).
model Policy {
  key       String   @id @db.VarChar(64)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Char(36)

  @@map("policies")
}

/// Platform settings (ownerId = "platform") and per-user preferences (ownerId = user id).
model Setting {
  ownerId   String   @map("owner_id") @db.VarChar(36)
  key       String   @db.VarChar(80)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([ownerId, key])
  @@map("settings")
}

model Notification {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  type      String    @db.VarChar(64)
  title     String    @db.VarChar(200)
  body      String?   @db.Text
  link      String?   @db.VarChar(500)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  /// Email routing outcome (WP-4): SENT, DIGEST_DAILY, DIGEST_WEEKLY, DIGESTED, SUPPRESSED; null when no email was requested.
  emailStatus String? @map("email_status") @db.VarChar(16)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, emailStatus])
  @@map("notifications")
}

model NotificationPreference {
  userId  String  @map("user_id") @db.Char(36)
  channel String  @db.VarChar(16)
  type    String  @db.VarChar(64)
  enabled Boolean @default(true)

  @@id([userId, channel, type])
  @@map("notification_preferences")
}

/// Append-only, hash-chained audit trail. No update/delete path exists in code.
model AuditEvent {
  id         BigInt   @id @default(autoincrement())
  occurredAt DateTime @default(now()) @map("occurred_at") @db.DateTime(3)
  actorId    String?  @map("actor_id") @db.Char(36)
  actorRole  String?  @map("actor_role") @db.VarChar(120)
  portal     String?  @db.VarChar(32)
  action     String   @db.VarChar(80)
  objectType String   @map("object_type") @db.VarChar(64)
  objectId   String   @map("object_id") @db.VarChar(64)
  before     Json?
  after      Json?
  reason     String?  @db.Text
  ip         String?  @db.VarChar(45)
  requestId  String?  @map("request_id") @db.VarChar(64)
  prevHash   String   @map("prev_hash") @db.Char(64)
  hash       String   @db.Char(64)

  @@index([objectType, objectId])
  @@index([actorId, occurredAt])
  @@index([occurredAt])
  @@map("audit_events")
}

/// Transactional outbox; the worker publishes rows to notification/email/screening handlers.
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  type        String    @db.VarChar(80)
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.Text
  /// Row claiming (WP-4): the worker instance holding the row and when it took it; stale claims are re-taken.
  claimedBy     String?   @map("claimed_by") @db.VarChar(64)
  claimedAt     DateTime? @map("claimed_at") @db.DateTime(3)
  nextAttemptAt DateTime? @map("next_attempt_at") @db.DateTime(3)

  @@index([publishedAt, id])
  @@map("outbox_events")
}

/// Named counters for human references (CL-00418, ONB-104829, REQ-2051 ...).
model Sequence {
  name  String @id @db.VarChar(32)
  value Int

  @@map("sequences")
}

// ============================================================ files ========

/// An encrypted binary in the file store. Referenced by documents, evidence, submissions.
model FileObject {
  id            String   @id @default(uuid()) @db.Char(36)
  storageKey    String   @unique @map("storage_key") @db.VarChar(200)
  name          String   @db.VarChar(255)
  mime          String   @db.VarChar(120)
  size          Int
  sha256        String   @db.Char(64)
  scanStatus    String   @default("clean") @map("scan_status") @db.VarChar(16)
  uploadedById  String?  @map("uploaded_by_id") @db.Char(36)
  /// Set when uploaded anonymously through an onboarding draft.
  applicationId String?  @map("application_id") @db.Char(36)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([applicationId])
  @@map("files")
}

// ============================================================ documents ====

model Document {
  id                String    @id @default(uuid()) @db.Char(36)
  ref               String    @unique @db.VarChar(32)
  name              String    @db.VarChar(255)
  /// report | statement | capital | legal | tax | kyc | company | other
  type              String    @db.VarChar(32)
  label             String?   @db.VarChar(120)
  /// Public | Client | Internal | Restricted
  classification    String    @default("Internal") @db.VarChar(16)
  /// Draft | In review | Approved | Published | Superseded | Restricted
  status            String    @default("Draft") @db.VarChar(24)
  ownerName         String?   @map("owner_name") @db.VarChar(120)
  relatedType       String?   @map("related_type") @db.VarChar(32)
  relatedId         String?   @map("related_id") @db.Char(36)
  relatedLabel      String?   @map("related_label") @db.VarChar(160)
  clientId          String?   @map("client_id") @db.Char(36)
  companyId         String?   @map("company_id") @db.Char(36)
  year              Int?
  documentDate      DateTime? @map("document_date")
  requiresSignature Boolean   @default(false) @map("requires_signature")
  retentionYears    Int       @default(7) @map("retention_years")
  /// LP category: QUARTERLY_STATEMENT | CALL_NOTICE | PERFORMANCE_REPORT | TAX | LEGAL | GOVERNANCE | MANUAL | DISTRIBUTIONS
  category          String?   @db.VarChar(32)
  fundId            String?   @map("fund_id") @db.Char(36)
  /// e.g. 2026-Q2
  period            String?   @db.VarChar(16)
  /// GP_UPLOAD | CAPITAL_CALL | CAPITAL_CALL_ALLOCATION | FUND_REPORT_SYNC | QUARTERLY_STATEMENT_SYNC | TAX_RETURN_PACK_SYNC
  sourceType        String?   @map("source_type") @db.VarChar(32)
  sourceRefId       String?   @map("source_ref_id") @db.Char(36)
  makerId           String?   @map("maker_id") @db.Char(36)
  checkerId         String?   @map("checker_id") @db.Char(36)
  approvedAt        DateTime? @map("approved_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String?   @map("created_by") @db.Char(36)
  updatedAt         DateTime  @updatedAt @map("updated_at")
  updatedBy         String?   @map("updated_by") @db.Char(36)
  version           Int       @default(1)

  versions          DocumentVersion[]
  publications      Publication[]
  reads             DocumentRead[]
  signatureRequests SignatureRequest[]

  @@index([clientId])
  @@index([companyId])
  @@index([relatedType, relatedId])
  @@index([fundId])
  @@map("documents")
}

model DocumentVersion {
  id           String   @id @default(uuid()) @db.Char(36)
  documentId   String   @map("document_id") @db.Char(36)
  version      Int
  fileId       String   @map("file_id") @db.Char(36)
  sha256       String   @db.Char(64)
  uploadedById String?  @map("uploaded_by_id") @db.Char(36)
  createdAt    DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@map("document_versions")
}

/// Makes an approved document visible to one client's investor users.
model Publication {
  id            String    @id @default(uuid()) @db.Char(36)
  documentId    String    @map("document_id") @db.Char(36)
  clientId      String    @map("client_id") @db.Char(36)
  publishedAt   DateTime  @default(now()) @map("published_at")
  publishedById String?   @map("published_by_id") @db.Char(36)
  withdrawnAt   DateTime? @map("withdrawn_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, clientId])
  @@index([clientId])
  @@map("publications")
}

model DocumentRead {
  documentId String   @map("document_id") @db.Char(36)
  userId     String   @map("user_id") @db.Char(36)
  readAt     DateTime @default(now()) @map("read_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([documentId, userId])
  @@map("document_reads")
}

model SignatureRequest {
  id            String    @id @default(uuid()) @db.Char(36)
  documentId    String    @map("document_id") @db.Char(36)
  clientId      String    @map("client_id") @db.Char(36)
  /// Pending | Signed | Cancelled
  status        String    @default("Pending") @db.VarChar(16)
  requestedById String?   @map("requested_by_id") @db.Char(36)
  dueDate       DateTime? @map("due_date")
  /// document | term_sheet
  subjectType   String?   @map("subject_type") @db.VarChar(32)
  subjectId     String?   @map("subject_id") @db.Char(36)
  createdAt     DateTime  @default(now()) @map("created_at")

  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signatures Signature[]

  @@index([clientId, status])
  @@map("signature_requests")
}

model Signature {
  id                    String    @id @default(uuid()) @db.Char(36)
  requestId             String    @map("request_id") @db.Char(36)
  signerUserId          String    @map("signer_user_id") @db.Char(36)
  signerName            String    @map("signer_name") @db.VarChar(120)
  authority             String    @db.VarChar(160)
  consentAt             DateTime  @map("consent_at")
  mfaAt                 DateTime? @map("mfa_at")
  docSha256             String    @map("doc_sha256") @db.Char(64)
  ip                    String?   @db.VarChar(45)
  consentTextVersion    String?   @map("consent_text_version") @db.VarChar(32)
  consentHash           String?   @map("consent_hash") @db.Char(64)
  userAgent             String?   @map("user_agent") @db.VarChar(255)
  sessionId             String?   @map("session_id") @db.Char(36)
  certificateDocumentId String?   @map("certificate_document_id") @db.Char(36)
  signedAt              DateTime  @default(now()) @map("signed_at")

  request SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("signatures")
}

// ============================================================ parties ======

model Client {
  id                  String    @id @default(uuid()) @db.Char(36)
  ref                 String    @unique @db.VarChar(16)
  name                String    @db.VarChar(200)
  type                String    @db.VarChar(64)
  baseCurrency        String    @default("USD") @map("base_currency") @db.Char(3)
  riskRating          String    @default("Medium") @map("risk_rating") @db.VarChar(16)
  /// Pending | Current | Review due | Enhanced review
  kycStatus           String    @default("Pending") @map("kyc_status") @db.VarChar(24)
  mandateLabel        String?   @map("mandate_label") @db.VarChar(120)
  ownerName           String?   @map("owner_name") @db.VarChar(120)
  relationshipOwnerId String?   @map("relationship_owner_id") @db.Char(36)
  email               String?   @db.VarChar(254)
  phone               String?   @db.VarChar(40)
  registrationRef     String?   @map("registration_ref") @db.VarChar(80)
  address             String?   @db.VarChar(255)
  notes               String?   @db.Text
  valueLabel          String?   @map("value_label") @db.VarChar(40)
  accountsCount       Int       @default(0) @map("accounts_count")
  nextReviewDate      DateTime? @map("next_review_date")
  portalEnabled       Boolean   @default(false) @map("portal_enabled")
  accreditedInvestor  Boolean   @default(true) @map("accredited_investor")
  dealingHold         Boolean   @default(false) @map("dealing_hold")
  holdReason          String?   @map("hold_reason") @db.VarChar(255)
  country             String?   @db.VarChar(80)
  archivedAt          DateTime? @map("archived_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  createdBy           String?   @map("created_by") @db.Char(36)
  updatedAt           DateTime  @updatedAt @map("updated_at")
  updatedBy           String?   @map("updated_by") @db.Char(36)
  version             Int       @default(1)

  users                   ClientUser[]
  mandates                Mandate[]
  cashAccounts            CashAccount[]
  capitalEvents           CapitalEvent[]
  serviceRequests         ServiceRequest[]
  threads                 MessageThread[]
  snapshots               InvestorSnapshot[]
  bankInstructions        BankInstruction[]
  commitments             FundCommitment[]
  holdings                LpHolding[]
  callAllocations         CapitalCallAllocation[]
  distributionAllocations DistributionAllocation[]
  dealingRequests         LpDealingRequest[]

  @@map("clients")
}

/// Links an investor-portal user to a client relationship with a role and account scope.
model ClientUser {
  id           String    @id @default(uuid()) @db.Char(36)
  clientId     String    @map("client_id") @db.Char(36)
  userId       String    @map("user_id") @db.Char(36)
  investorRole String    @default("admin") @map("investor_role") @db.VarChar(32)
  accountScope String    @default("all") @map("account_scope") @db.VarChar(32)
  /// Fund ids this member may see; null = every commitment of the client.
  fundIds      Json?     @map("fund_ids")
  /// VIEWER | SIGNATORY | MANAGER; null = derived from investor_role.
  lpRole       String?   @map("lp_role") @db.VarChar(16)
  /// ACTIVE | INVITED | SUSPENDED
  status       String    @default("ACTIVE") @db.VarChar(16)
  revokedAt    DateTime? @map("revoked_at")
  invitedById  String?   @map("invited_by_id") @db.Char(36)
  createdAt    DateTime  @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@map("client_users")
}

model Mandate {
  id        String   @id @default(uuid()) @db.Char(36)
  ref       String   @unique @db.VarChar(16)
  clientId  String   @map("client_id") @db.Char(36)
  name      String   @db.VarChar(160)
  /// discretionary | cis | private_markets | treasury | advisory
  type      String   @db.VarChar(32)
  /// Shell | Active | Closed
  status    String   @default("Shell") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Char(36)
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("mandates")
}

model CashAccount {
  id            String    @id @default(uuid()) @db.Char(36)
  ref           String    @unique @db.VarChar(16)
  clientId      String    @map("client_id") @db.Char(36)
  mandateId     String?   @map("mandate_id") @db.Char(36)
  legalEntity   String    @map("legal_entity") @db.VarChar(200)
  /// SEGREGATED | OMNIBUS | HYBRID
  ownership     String    @default("SEGREGATED") @db.VarChar(16)
  moneyClass    String    @default("Client money") @map("money_class") @db.VarChar(40)
  type          String    @default("Settlement") @db.VarChar(40)
  provider      String    @default("Pending") @db.VarChar(120)
  identifierEnc String?   @map("identifier_enc") @db.Text
  masked        String    @default("Pending") @db.VarChar(40)
  currency      String    @default("USD") @db.Char(3)
  /// Portfolio mapping, GL/tolerance policy and last imported statement balances
  /// (stand-in until the Phase 2 cash ledger derives balances from journals).
  meta          Json?
  /// DRAFT | PENDING_APPROVAL | ACTIVE | SUSPENDED | CLOSING | CLOSED
  status        String    @default("DRAFT") @db.VarChar(20)
  makerId       String?   @map("maker_id") @db.Char(36)
  checkerId     String?   @map("checker_id") @db.Char(36)
  submittedAt   DateTime? @map("submitted_at")
  approvedAt    DateTime? @map("approved_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  version       Int       @default(1)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("cash_accounts")
}

// ============================================================ onboarding ===

model OnboardingApplication {
  id                  String    @id @default(uuid()) @db.Char(36)
  /// ONB-###### assigned on submit.
  ref                 String?   @unique @db.VarChar(16)
  /// Investor portal | Assisted
  channel             String    @default("Investor portal") @db.VarChar(32)
  applicantType       String    @default("Individual") @map("applicant_type") @db.VarChar(64)
  legalName           String?   @map("legal_name") @db.VarChar(200)
  email               String    @db.VarChar(254)
  emailVerifiedAt     DateTime? @map("email_verified_at")
  phone               String?   @db.VarChar(40)
  country             String?   @db.VarChar(80)
  registrationRef     String?   @map("registration_ref") @db.VarChar(80)
  expectedInvestment  Decimal?  @map("expected_investment") @db.Decimal(20, 4)
  relationship        String?   @db.VarChar(80)
  classification      String?   @db.VarChar(80)
  baseCurrency        String?   @map("base_currency") @db.VarChar(8)
  riskProfile         String?   @map("risk_profile") @db.VarChar(40)
  liquidityNeed       String?   @map("liquidity_need") @db.VarChar(40)
  purpose             String?   @db.Text
  sourceOfFunds       String?   @map("source_of_funds") @db.Text
  sourceOfWealth      String?   @map("source_of_wealth") @db.Text
  taxResidence        String?   @map("tax_residence") @db.VarChar(80)
  taxIdEnc            String?   @map("tax_id_enc") @db.Text
  taxStatus           String?   @map("tax_status") @db.VarChar(80)
  pep                 String?   @db.VarChar(16)
  bankJurisdiction    String?   @map("bank_jurisdiction") @db.VarChar(80)
  signingAuthority    String?   @map("signing_authority") @db.VarChar(160)
  expectedActivity    String?   @map("expected_activity") @db.Text
  /// Full form payload used to restore the draft exactly as typed (tax id removed).
  formData            Json?     @map("form_data")
  consentAt           DateTime? @map("consent_at")
  /// Draft | Submitted
  status              String    @default("Draft") @db.VarChar(16)
  submittedAt         DateTime? @map("submitted_at")
  draftTokenHash      String?   @unique @map("draft_token_hash") @db.Char(64)
  draftTokenExpiresAt DateTime? @map("draft_token_expires_at")
