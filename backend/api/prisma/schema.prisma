  pep           Boolean  @default(false)

  application OnboardingApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("beneficial_owners")
}

model KycCase {
  id                   String    @id @default(uuid()) @db.Char(36)
  ref                  String    @unique @db.VarChar(16)
  applicationId        String    @unique @map("application_id") @db.Char(36)
  clientId             String?   @map("client_id") @db.Char(36)
  /// Submitted | Screening | ComplianceReview | ClientAction | EnhancedReview | Approved | Rejected | Activation | Active
  stage                String    @default("Submitted") @db.VarChar(24)
  /// Pending | Low | Medium | High
  risk                 String    @default("Pending") @db.VarChar(16)
  slaState             String    @default("New") @map("sla_state") @db.VarChar(24)
  slaDueAt             DateTime? @map("sla_due_at")
  ownerId              String?   @map("owner_id") @db.Char(36)
  ownerName            String    @default("Client Services intake") @map("owner_name") @db.VarChar(120)
  preparedById         String?   @map("prepared_by_id") @db.Char(36)
  decision             String?   @db.VarChar(24)
  decisionReason       String?   @map("decision_reason") @db.Text
  decidedById          String?   @map("decided_by_id") @db.Char(36)
  decidedAt            DateTime? @map("decided_at")
  enhancedReviewDoneAt DateTime? @map("enhanced_review_done_at")
  fundsApproved        Boolean   @default(false) @map("funds_approved")
  checklist            Json?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  version              Int       @default(1)

  application OnboardingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  evidence    KycEvidence[]
  screening   ScreeningResult[]
  events      KycCaseEvent[]

  @@index([stage])
  @@map("kyc_cases")
}

model KycEvidence {
  id            String    @id @default(uuid()) @db.Char(36)
  caseId        String?   @map("case_id") @db.Char(36)
  applicationId String    @map("application_id") @db.Char(36)
  /// doc1..doc8 slot keys from the onboarding form.
  slot          String    @db.VarChar(16)
  label         String    @db.VarChar(80)
  fileId        String?   @map("file_id") @db.Char(36)
  /// Missing | Received | Accepted | Rejected
  status        String    @default("Received") @db.VarChar(16)
  reviewerId    String?   @map("reviewer_id") @db.Char(36)
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  kycCase KycCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([applicationId, slot])
  @@map("kyc_evidence")
}

model ScreeningResult {
  id         String   @id @default(uuid()) @db.Char(36)
  caseId     String   @map("case_id") @db.Char(36)
  provider   String   @db.VarChar(64)
  /// sanctions | pep | adverse_media | document
  type       String   @db.VarChar(24)
  /// Clear | Review | Match
  outcome    String   @db.VarChar(16)
  score      Int?
  rawRef     String?  @map("raw_ref") @db.VarChar(120)
  receivedAt DateTime @default(now()) @map("received_at")

  kycCase KycCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("screening_results")
}

model KycCaseEvent {
  id      String   @id @default(uuid()) @db.Char(36)
  caseId  String   @map("case_id") @db.Char(36)
  at      DateTime @default(now())
  title   String   @db.VarChar(200)
  detail  String?  @db.Text
  actorId String?  @map("actor_id") @db.Char(36)

  kycCase KycCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, at])
  @@map("kyc_case_events")
}

