// ---- Investee Workspace ----

/// One row per portfolio company: ledger entity for share-capital journals, forecast scenario, and the one-time move of the old Setting JSON.
model InvesteeWorkspace {
  companyId         String    @id @map("company_id") @db.Char(36)
  ledgerPortfolioId String?   @map("ledger_portfolio_id") @db.Char(36)
  forecastScenario  String    @default("Base case") @map("forecast_scenario") @db.VarChar(16)
