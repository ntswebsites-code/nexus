// ============================================================ published investor snapshots
// Stand-in for IBOR/PBOR until Phase 2: staff import a valuation-dated snapshot
// per client, a second approver publishes it, and the investor portal reads the
// latest Published snapshot only.

model InvestorSnapshot {
  id                String    @id @default(uuid()) @db.Char(36)
  clientId          String    @map("client_id") @db.Char(36)
  valuationDate     DateTime  @map("valuation_date") @db.Date
  /// Draft | Published | Superseded
  status            String    @default("Draft") @db.VarChar(16)
  reportingCurrency String    @default("USD") @map("reporting_currency") @db.Char(3)
  fx                Json
  /// NAV, unfunded, cash, net flows, YTD, benchmark, actions ...
  metrics           Json
  activity          Json?
  makerId           String?   @map("maker_id") @db.Char(36)
  checkerId         String?   @map("checker_id") @db.Char(36)
  publishedAt       DateTime? @map("published_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  version           Int       @default(1)

  client       Client                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  investments  SnapshotInvestment[]
  holdings     SnapshotHolding[]
  transactions SnapshotTransaction[]
  performance  SnapshotPerformancePoint[]
  allocation   SnapshotAllocation[]

  @@index([clientId, status])
  @@map("investor_snapshots")
}

model SnapshotInvestment {
  id            String   @id @default(uuid()) @db.Char(36)
  snapshotId    String   @map("snapshot_id") @db.Char(36)
  key           String   @db.VarChar(24)
  name          String   @db.VarChar(160)
  kind          String   @db.VarChar(64)
  value         Decimal  @db.Decimal(20, 4)
  returnPct     Decimal? @map("return_pct") @db.Decimal(9, 4)
  benchmarkPct  Decimal? @map("benchmark_pct") @db.Decimal(9, 4)
  currency      String   @default("USD") @db.Char(3)
  status        String   @db.VarChar(64)
  commitment    Decimal? @db.Decimal(20, 4)
  called        Decimal? @db.Decimal(20, 4)
  unfunded      Decimal? @db.Decimal(20, 4)
  distributions Decimal? @db.Decimal(20, 4)
  irr           Decimal? @db.Decimal(9, 4)
  tvpi          Decimal? @db.Decimal(9, 4)
  dpi           Decimal? @db.Decimal(9, 4)
  sort          Int      @default(0)

  snapshot InvestorSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@map("snapshot_investments")
}

model SnapshotHolding {
  id         String  @id @default(uuid()) @db.Char(36)
  snapshotId String  @map("snapshot_id") @db.Char(36)
  key        String  @db.VarChar(24)
  security   String  @db.VarChar(160)
  account    String  @db.VarChar(120)
  asset      String  @db.VarChar(64)
  quantity   String  @db.VarChar(40)
  price      String  @db.VarChar(40)
  value      Decimal @db.Decimal(20, 4)
  weightPct  Decimal @map("weight_pct") @db.Decimal(9, 4)
  ytdPct     Decimal @map("ytd_pct") @db.Decimal(9, 4)
  sort       Int     @default(0)

  snapshot InvestorSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@map("snapshot_holdings")
}

model SnapshotTransaction {
  id          String   @id @default(uuid()) @db.Char(36)
  snapshotId  String   @map("snapshot_id") @db.Char(36)
  key         String   @db.VarChar(24)
  tradeDate   DateTime @map("trade_date") @db.Date
  type        String   @db.VarChar(32)
  account     String   @db.VarChar(120)
  description String   @db.VarChar(255)
  quantity    String   @db.VarChar(40)
  amount      Decimal  @db.Decimal(20, 4)
  status      String   @db.VarChar(32)
  sort        Int      @default(0)

  snapshot InvestorSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@map("snapshot_transactions")
}

model SnapshotPerformancePoint {
  id           String   @id @default(uuid()) @db.Char(36)
  snapshotId   String   @map("snapshot_id") @db.Char(36)
  /// 1M | 3M | YTD | 1Y | 3Y
  range        String   @db.VarChar(8)
  idx          Int
  portfolioPct Decimal  @map("portfolio_pct") @db.Decimal(9, 4)
  benchmarkPct Decimal? @map("benchmark_pct") @db.Decimal(9, 4)

  snapshot InvestorSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId, range])
  @@map("snapshot_performance_points")
}

model SnapshotAllocation {
  id         String  @id @default(uuid()) @db.Char(36)
  snapshotId String  @map("snapshot_id") @db.Char(36)
  label      String  @db.VarChar(80)
  pct        Decimal @db.Decimal(9, 4)
  sort       Int     @default(0)

  snapshot InvestorSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@map("snapshot_allocation")
}

// ============================================================ company reporting

model PortfolioCompany {
  id                 String   @id @default(uuid()) @db.Char(36)
  ref                String   @unique @db.VarChar(16)
  name               String   @db.VarChar(200)
  legalName          String   @map("legal_name") @db.VarChar(255)
  ticker             String   @db.VarChar(16)
  sector             String   @db.VarChar(120)
  country            String   @db.VarChar(80)
  founded            Int?
  employees          Int?
  website            String?  @db.VarChar(255)
  address            String?  @db.VarChar(255)
  /// Fund, ownership, invested, entry, deal team.
  relationship       Json
  contacts           Json
  cashRunway         Json?    @map("cash_runway")
  volumeSeries       Json?    @map("volume_series")
  /// Prospect | Pending | Approved | Active | Inactive | Closed | Exited
  status             String   @default("Active") @db.VarChar(16)
  fundId             String?  @map("fund_id") @db.Char(36)
  registrationNumber String?  @map("registration_number") @db.VarChar(80)
  industry           String?  @db.VarChar(120)
  fundingStage       String?  @map("funding_stage") @db.VarChar(40)
  reportingCurrency  String   @default("USD") @map("reporting_currency") @db.Char(3)
  letterhead         Json?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  version            Int      @default(1)

  users      CompanyUser[]
  periods    ReportingPeriod[]
  kpis       CompanyKpi[]
  covenants  Covenant[]
  questions  ReportingQuestion[]
  termSheets TermSheet[]

  @@map("portfolio_companies")
}

model CompanyUser {
  companyId        String    @map("company_id") @db.Char(36)
  userId           String    @map("user_id") @db.Char(36)
  /// workspace_administrator | executive_approver | report_contributor | kpi_owner | finance_editor | read_only
  profile          String    @default("workspace_administrator") @db.VarChar(32)
  /// active | disabled
  status           String    @default("active") @db.VarChar(16)
  title            String?   @db.VarChar(120)
  invitedById      String?   @map("invited_by_id") @db.Char(36)
  lastActiveAt     DateTime? @map("last_active_at")
  signingAuthority Json?     @map("signing_authority")
  createdAt        DateTime  @default(now()) @map("created_at")

  company PortfolioCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([companyId, userId])
  @@map("company_users")
}

model CompanyKpi {
  id        String  @id @default(uuid()) @db.Char(36)
  companyId String  @map("company_id") @db.Char(36)
  key       String  @db.VarChar(32)
  label     String  @db.VarChar(120)
  unit      String  @db.VarChar(8)
  invert    Boolean @default(false)
  prev      Decimal @db.Decimal(20, 4)
  budget    Decimal @db.Decimal(20, 4)
  series    Json
  sort      Int     @default(0)

  company PortfolioCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@map("company_kpis")
}

model ReportingPeriod {
  id            String    @id @default(uuid()) @db.Char(36)
  companyId     String    @map("company_id") @db.Char(36)
  /// YYYY-MM
  period        String    @db.VarChar(7)
  label         String    @db.VarChar(32)
  dueDate       DateTime  @map("due_date") @db.Date
  /// WEEKLY | MONTHLY | QUARTERLY | ANNUAL
  periodType    String    @default("MONTHLY") @map("period_type") @db.VarChar(16)
  periodStart   DateTime? @map("period_start") @db.Date
  periodEnd     DateTime? @map("period_end") @db.Date
  requestedAt   DateTime? @map("requested_at")
  closedAt      DateTime? @map("closed_at")
  /// open | submitted | accepted | returned
  status        String    @default("open") @db.VarChar(16)
  kpiValues     Json?     @map("kpi_values")
  notes         String?   @db.Text
  submittedAt   DateTime? @map("submitted_at")
  submittedById String?   @map("submitted_by_id") @db.Char(36)
  reviewedById  String?   @map("reviewed_by_id") @db.Char(36)
  reviewerName  String?   @map("reviewer_name") @db.VarChar(120)
  reviewedAt    DateTime? @map("reviewed_at")
  reviewNote    String?   @map("review_note") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  version       Int       @default(1)

  company PortfolioCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   ReportingItem[]

  @@unique([companyId, period])
  @@map("reporting_periods")
}

model ReportingItem {
  id        String    @id @default(uuid()) @db.Char(36)
  periodId  String    @map("period_id") @db.Char(36)
  /// accounts | kpis | debt | board | compliance
  key       String    @db.VarChar(32)
  title     String    @db.VarChar(120)
  detail    String    @db.VarChar(255)
  required  Boolean   @default(true)
  accept    String    @db.VarChar(80)
  /// Due | Complete | Expiring
  status    String    @default("Due") @db.VarChar(16)
  expiresAt DateTime? @map("expires_at")
  sort      Int       @default(0)

  period      ReportingPeriod       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  submissions ReportingSubmission[]

  @@unique([periodId, key])
  @@map("reporting_items")
}

model ReportingSubmission {
  id           String   @id @default(uuid()) @db.Char(36)
  itemId       String   @map("item_id") @db.Char(36)
  fileId       String   @map("file_id") @db.Char(36)
  name         String   @db.VarChar(255)
  size         Int
  /// Draft | Submitted | Accepted | Returned
  status       String   @default("Draft") @db.VarChar(16)
  uploadedById String?  @map("uploaded_by_id") @db.Char(36)
  createdAt    DateTime @default(now()) @map("created_at")

  item ReportingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("reporting_submissions")
}

/// Question thread between the investment team and a portfolio company.
model ReportingQuestion {
  id        String   @id @default(uuid()) @db.Char(36)
  ref       String   @unique @db.VarChar(16)
  companyId String   @map("company_id") @db.Char(36)
  periodId  String?  @map("period_id") @db.Char(36)
  title     String   @db.VarChar(200)
  fromName  String   @map("from_name") @db.VarChar(120)
  fromRole  String   @map("from_role") @db.VarChar(120)
  /// open | resolved
  status    String   @default("open") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  PortfolioCompany           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages ReportingQuestionMessage[]

  @@index([companyId, status])
  @@map("reporting_questions")
}

model ReportingQuestionMessage {
  id          String   @id @default(uuid()) @db.Char(36)
  questionId  String   @map("question_id") @db.Char(36)
  authorId    String?  @map("author_id") @db.Char(36)
  authorName  String   @map("author_name") @db.VarChar(120)
  fromCompany Boolean  @map("from_company")
  body        String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  question ReportingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("reporting_question_messages")
}

model Covenant {
  id        String  @id @default(uuid()) @db.Char(36)
  companyId String  @map("company_id") @db.Char(36)
  key       String  @db.VarChar(32)
  name      String  @db.VarChar(160)
  threshold String  @db.VarChar(120)
  actual    Decimal @db.Decimal(20, 4)
  limit     Decimal @db.Decimal(20, 4)
  unit      String  @db.VarChar(8)
  headroom  String  @db.VarChar(40)
  /// current | expiring
  evidence  String  @default("current") @db.VarChar(16)
  note      String? @db.VarChar(255)
  sort      Int     @default(0)

  company PortfolioCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@map("covenants")
}

// ============================================================ fund operations (SRD 10.3.3, day-one slice)

/// Fund master. NAV per unit, valuation status and dealing rules live here for the day-one slice (SRD 10.3.3 A).
model Fund {
  id                String    @id @default(uuid()) @db.Char(36)
  ref               String    @unique @db.VarChar(16)
  name              String    @db.VarChar(200)
  shortName         String    @map("short_name") @db.VarChar(80)
  publicReference   String?   @map("public_reference") @db.VarChar(40)
  /// PRIVATE_CAPITAL | OPEN_ENDED
  operatingModel    String    @default("PRIVATE_CAPITAL") @map("operating_model") @db.VarChar(32)
  currency          String    @default("USD") @db.Char(3)
  vintage           Int?      @db.SmallInt
  /// Draft | Active | Closed
  status            String    @default("Active") @db.VarChar(16)
  portalVisible     Boolean   @default(true) @map("portal_visible")
  defaultShareClass String?   @map("default_share_class") @db.VarChar(32)
  /// ESTIMATED | PROVISIONAL | FINAL | RESTATED
  valuationStatus   String    @default("FINAL") @map("valuation_status") @db.VarChar(16)
  asOfDate          DateTime? @map("as_of_date") @db.Date
  navPerUnit        Decimal?  @map("nav_per_unit") @db.Decimal(20, 8)
  totalNav          Decimal?  @map("total_nav") @db.Decimal(20, 4)
  /// LpDealingRules + navHistory for the day-one slice.
  dealingRulesJson  Json?     @map("dealing_rules_json")
  /// Default wiring for capital calls (account number encrypted at rest by the service).
  wiringJson        Json?     @map("wiring_json")
  makerId           String?   @map("maker_id") @db.Char(36)
  checkerId         String?   @map("checker_id") @db.Char(36)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  version           Int       @default(1)
  /// Logical link to the portfolio that holds this fund's assets (NAV module); no FK. A released NAV run updates
  /// nav_per_unit / total_nav / as_of_date / valuation_status above.
  portfolioId       String?   @map("portfolio_id") @db.Char(36)

  commitments     FundCommitment[]
  holdings        LpHolding[]
  capitalCalls    CapitalCall[]
  distributions   Distribution[]
  dealingRequests LpDealingRequest[]

  @@map("funds")
}

model FundCommitment {
  id                 String    @id @default(uuid()) @db.Char(36)
  clientId           String    @map("client_id") @db.Char(36)
  fundId             String    @map("fund_id") @db.Char(36)
  commitmentAmount   Decimal   @map("commitment_amount") @db.Decimal(20, 4)
  currency           String    @default("USD") @db.Char(3)
  /// PENDING | ACTIVE | CLOSED
  status             String    @default("ACTIVE") @db.VarChar(16)
  effectiveDate      DateTime? @map("effective_date") @db.Date
  investorAccountRef String?   @map("investor_account_ref") @db.VarChar(64)
  /// Stored performance figures (IRR, TVPI, DPI, RVPI, NAV); never computed in the portal.
  metricsJson        Json?     @map("metrics_json")
  notes              String?   @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  version            Int       @default(1)

  client                  Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fund                    Fund                     @relation(fields: [fundId], references: [id], onDelete: Cascade)
  callAllocations         CapitalCallAllocation[]
  distributionAllocations DistributionAllocation[]

  @@unique([clientId, fundId])
  @@index([fundId])
  @@map("fund_commitments")
}

model LpHolding {
  id              String   @id @default(uuid()) @db.Char(36)
  clientId        String   @map("client_id") @db.Char(36)
  fundId          String   @map("fund_id") @db.Char(36)
  shareClassCode  String   @default("DEFAULT") @map("share_class_code") @db.VarChar(32)
  units           Decimal  @db.Decimal(24, 8)
  navPerUnit      Decimal  @map("nav_per_unit") @db.Decimal(20, 8)
  accountValue    Decimal  @map("account_value") @db.Decimal(20, 4)
  currency        String   @default("USD") @db.Char(3)
  accountRef      String?  @map("account_ref") @db.VarChar(64)
  asOfDate        DateTime @map("as_of_date") @db.Date
  valuationStatus String   @default("FINAL") @map("valuation_status") @db.VarChar(16)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@unique([clientId, fundId, shareClassCode])
  @@map("lp_holdings")
}

/// A capital call header. LPs only see it once `issuedAt` is set and status is not DRAFT/CANCELLED.
model CapitalCall {
  id               String    @id @default(uuid()) @db.Char(36)
  ref              String    @unique @db.VarChar(16)
  fundId           String    @map("fund_id") @db.Char(36)
  callNo           Int       @map("call_no")
  callPercent      Decimal?  @map("call_percent") @db.Decimal(12, 6)
  totalAmount      Decimal   @map("total_amount") @db.Decimal(20, 4)
  currency         String    @default("USD") @db.Char(3)
  dueDate          DateTime  @map("due_date") @db.Date
  transactionDate  DateTime? @map("transaction_date") @db.Date
  /// bank, accountName, accountNumberEnc, accountNumberMasked, abaRouting, reference
  wireJson         Json?     @map("wire_json")
  wireText         String?   @map("wire_text") @db.Text
  purpose          String?   @db.Text
  noticeDocumentId String?   @map("notice_document_id") @db.Char(36)
  /// DRAFT | PENDING_APPROVAL | APPROVED | ISSUED | PARTIALLY_PAID | PAID | CANCELLED
  status           String    @default("DRAFT") @db.VarChar(20)
  makerId          String?   @map("maker_id") @db.Char(36)
  checkerId        String?   @map("checker_id") @db.Char(36)
  approvedAt       DateTime? @map("approved_at")
  issuedAt         DateTime? @map("issued_at")
  cancelledAt      DateTime? @map("cancelled_at")
  cancelReason     String?   @map("cancel_reason") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  version          Int       @default(1)

  fund        Fund                    @relation(fields: [fundId], references: [id], onDelete: Restrict)
  allocations CapitalCallAllocation[]

  @@unique([fundId, callNo])
  @@index([status])
  @@map("capital_calls")
}

/// Per-LP share of a call. The LP-facing "capital call id" is this row's id.
model CapitalCallAllocation {
  id                      String    @id @default(uuid()) @db.Char(36)
  callId                  String    @map("call_id") @db.Char(36)
  clientId                String    @map("client_id") @db.Char(36)
  commitmentId            String    @map("commitment_id") @db.Char(36)
  lpLegalNameSnapshot     String    @map("lp_legal_name_snapshot") @db.VarChar(255)
  totalCommitmentSnapshot Decimal   @map("total_commitment_snapshot") @db.Decimal(20, 4)
  uncalledBeforeSnapshot  Decimal   @map("uncalled_before_snapshot") @db.Decimal(20, 4)
  callAmount              Decimal   @map("call_amount") @db.Decimal(20, 4)
  amountPaid              Decimal   @default(0) @map("amount_paid") @db.Decimal(20, 4)
  /// PENDING | PARTIALLY_PAID | PAID | CANCELLED (acknowledgement never changes this)
  status                  String    @default("PENDING") @db.VarChar(20)
  acknowledgedAt          DateTime? @map("acknowledged_at")
  acknowledgedById        String?   @map("acknowledged_by_id") @db.Char(36)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  version                 Int       @default(1)

  call       CapitalCall          @relation(fields: [callId], references: [id], onDelete: Cascade)
  client     Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  commitment FundCommitment       @relation(fields: [commitmentId], references: [id], onDelete: Restrict)
  payments   CapitalCallPayment[]

  @@unique([callId, clientId])
  @@index([clientId])
  @@map("capital_call_allocations")
}

/// Append-only receipt. The matcher must differ from whoever uploaded the proof of payment.
model CapitalCallPayment {
  id             String   @id @default(uuid()) @db.Char(36)
  allocationId   String   @map("allocation_id") @db.Char(36)
  amount         Decimal  @db.Decimal(20, 4)
  recordedAt     DateTime @default(now()) @map("recorded_at")
  recordedById   String   @map("recorded_by_id") @db.Char(36)
  bankReference  String?  @map("bank_reference") @db.VarChar(80)
  confirmationId String?  @map("confirmation_id") @db.Char(36)

  allocation CapitalCallAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  @@index([allocationId])
  @@map("capital_call_payments")
}

model Distribution {
  id                String    @id @default(uuid()) @db.Char(36)
  ref               String    @unique @db.VarChar(16)
  fundId            String    @map("fund_id") @db.Char(36)
  distributionDate  DateTime  @map("distribution_date") @db.Date
  /// RETURN_OF_CAPITAL | REALISATION_PROCEEDS | DIVIDEND | INTEREST | INCOME | OTHER
  type              String    @db.VarChar(32)
  currency          String    @default("USD") @db.Char(3)
  grossAmount       Decimal   @map("gross_amount") @db.Decimal(20, 4)
  carryAmount       Decimal   @default(0) @map("carry_amount") @db.Decimal(20, 4)
  adjustmentsAmount Decimal   @default(0) @map("adjustments_amount") @db.Decimal(20, 4)
  netToLps          Decimal   @map("net_to_lps") @db.Decimal(20, 4)
  /// DRAFT | PENDING_APPROVAL | APPROVED | ISSUED | PARTIALLY_PAID | PAID | CANCELLED
  status            String    @default("DRAFT") @db.VarChar(20)
  notes             String?   @db.Text
  makerId           String?   @map("maker_id") @db.Char(36)
  checkerId         String?   @map("checker_id") @db.Char(36)
  issuedAt          DateTime? @map("issued_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  version           Int       @default(1)

  fund        Fund                     @relation(fields: [fundId], references: [id], onDelete: Restrict)
  allocations DistributionAllocation[]

  @@index([status])
  @@map("distributions")
}

model DistributionAllocation {
  id                       String    @id @default(uuid()) @db.Char(36)
  distributionId           String    @map("distribution_id") @db.Char(36)
  clientId                 String    @map("client_id") @db.Char(36)
  commitmentId             String    @map("commitment_id") @db.Char(36)
  lpLegalNameSnapshot      String    @map("lp_legal_name_snapshot") @db.VarChar(255)
  commitmentSnapshot       Decimal   @map("commitment_snapshot") @db.Decimal(20, 4)
  paidInSnapshot           Decimal   @default(0) @map("paid_in_snapshot") @db.Decimal(20, 4)
  grossShare               Decimal   @default(0) @map("gross_share") @db.Decimal(20, 4)
  adjustments              Decimal   @default(0) @db.Decimal(20, 4)
  shareAmount              Decimal   @map("share_amount") @db.Decimal(20, 4)
  amountPaid               Decimal   @default(0) @map("amount_paid") @db.Decimal(20, 4)
  /// PENDING | PARTIALLY_PAID | PAID | CANCELLED
  status                   String    @default("PENDING") @db.VarChar(20)
  destinationBankAccountId String?   @map("destination_bank_account_id") @db.Char(36)
  documentId               String?   @map("document_id") @db.Char(36)
  paidAt                   DateTime? @map("paid_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  version                  Int       @default(1)

  distribution Distribution   @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  commitment   FundCommitment @relation(fields: [commitmentId], references: [id], onDelete: Restrict)

  @@unique([distributionId, clientId])
  @@index([clientId])
  @@map("distribution_allocations")
}

/// Targeted publication to LPs. Receipts are per person.
model LpNotice {
  id                      String    @id @default(uuid()) @db.Char(36)
  ref                     String    @unique @db.VarChar(16)
  title                   String    @db.VarChar(512)
  body                    String    @db.Text
  /// CAPITAL_CALL | REPORT | POLICY | GENERAL
  category                String    @default("GENERAL") @db.VarChar(32)
  /// ALL | FUND | ORG | USER
  targetType              String    @default("ALL") @map("target_type") @db.VarChar(16)
  fundId                  String?   @map("fund_id") @db.Char(36)
  clientId                String?   @map("client_id") @db.Char(36)
  userId                  String?   @map("user_id") @db.Char(36)
  shareClassCode          String?   @map("share_class_code") @db.VarChar(32)
  requiresAcknowledgement Boolean   @default(true) @map("requires_acknowledgement")
  /// DRAFT | PUBLISHED | WITHDRAWN | EXPIRED
  status                  String    @default("DRAFT") @db.VarChar(16)
  publishedAt             DateTime? @map("published_at")
  expiresAt               DateTime? @map("expires_at")
  publishedById           String?   @map("published_by_id") @db.Char(36)
  approvedById            String?   @map("approved_by_id") @db.Char(36)
  createdById             String?   @map("created_by_id") @db.Char(36)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  version                 Int       @default(1)

  receipts LpNoticeReceipt[]

  @@index([status, publishedAt])
  @@map("lp_notices")
}

model LpNoticeReceipt {
  id             String    @id @default(uuid()) @db.Char(36)
  noticeId       String    @map("notice_id") @db.Char(36)
  clientId       String    @map("client_id") @db.Char(36)
  userId         String    @map("user_id") @db.Char(36)
  deliveredAt    DateTime  @default(now()) @map("delivered_at")
  openedAt       DateTime? @map("opened_at")
  acknowledgedAt DateTime? @map("acknowledged_at")

  notice LpNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@index([clientId])
  @@map("lp_notice_receipts")
}

model LpDealingRequest {
  id                   String    @id @default(uuid()) @db.Char(36)
  ref                  String    @unique @db.VarChar(16)
  clientId             String    @map("client_id") @db.Char(36)
  fundId               String    @map("fund_id") @db.Char(36)
  shareClassCode       String    @default("DEFAULT") @map("share_class_code") @db.VarChar(32)
  /// SUBSCRIPTION | REDEMPTION
  requestType          String    @map("request_type") @db.VarChar(16)
  /// AMOUNT | UNITS | FULL
  inputMode            String    @default("AMOUNT") @map("input_mode") @db.VarChar(8)
  /// FULL | PARTIAL
  redemptionMode       String?   @map("redemption_mode") @db.VarChar(8)
  amount               Decimal?  @db.Decimal(20, 4)
  units                Decimal?  @db.Decimal(24, 8)
  currency             String    @default("USD") @db.Char(3)
  requestedDealingDate DateTime? @map("requested_dealing_date") @db.Date
  /// SUBMITTED | COMPLIANCE_REVIEW | AWAITING_FUNDS | AWAITING_NAV | UNDER_REVIEW | COMPLETED | REJECTED | CANCELLED
  status               String    @default("SUBMITTED") @db.VarChar(20)
  estimateId           String?   @unique @map("estimate_id") @db.Char(36)
  estimateJson         Json?     @map("estimate_json")
  payloadHash          String?   @map("payload_hash") @db.Char(64)
  bankAccountId        String?   @map("bank_account_id") @db.Char(36)
  submittedById        String?   @map("submitted_by_id") @db.Char(36)
  notes                String?   @db.Text
  processedById        String?   @map("processed_by_id") @db.Char(36)
  approvedById         String?   @map("approved_by_id") @db.Char(36)
  dealingNavPerUnit    Decimal?  @map("dealing_nav_per_unit") @db.Decimal(20, 8)
  unitsAllocated       Decimal?  @map("units_allocated") @db.Decimal(24, 8)
  rejectionReason      String?   @map("rejection_reason") @db.VarChar(255)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  version              Int       @default(1)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Restrict)

  @@index([clientId, fundId])
  @@index([status])
  @@map("lp_dealing_requests")
}

/// Short-lived estimate snapshot (15 minutes). One estimate backs at most one request.
model DealingEstimate {
  id                  String   @id @default(uuid()) @db.Char(36)
  clientId            String   @map("client_id") @db.Char(36)
  fundId              String   @map("fund_id") @db.Char(36)
  estimateType        String   @map("estimate_type") @db.VarChar(16)
  estimateJson        Json     @map("estimate_json")
  payloadHash         String   @map("payload_hash") @db.Char(64)
  consumedByRequestId String?  @map("consumed_by_request_id") @db.Char(36)
  createdAt           DateTime @default(now()) @map("created_at")
  expiresAt           DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("dealing_estimates")
}

/// Idempotency for money and portal writes: claimed before the handler runs; only 2xx replayed.
model IdempotencyKey {
  id             BigInt   @id @default(autoincrement())
  userId         String   @map("user_id") @db.Char(36)
  clientId       String?  @map("client_id") @db.Char(36)
  scope          String   @db.VarChar(255)
  idemKey        String   @map("idem_key") @db.VarChar(200)
  requestHash    String   @map("request_hash") @db.Char(64)
  /// IN_PROGRESS | COMPLETED
  state          String   @default("IN_PROGRESS") @db.VarChar(16)
  responseStatus Int?     @map("response_status")
  responseBody   String?  @map("response_body") @db.LongText
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  @@unique([userId, scope, idemKey])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// High-volume document access log (VIEW, PREVIEW, DOWNLOAD); DOWNLOAD is also audited.
model DocumentAccessLog {
  id         BigInt   @id @default(autoincrement())
  documentId String   @map("document_id") @db.Char(36)
  userId     String?  @map("user_id") @db.Char(36)
  clientId   String?  @map("client_id") @db.Char(36)
  action     String   @db.VarChar(16)
  ip         String?  @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  at         DateTime @default(now())

  @@index([documentId])
  @@index([clientId, action, at])
  @@map("document_access_log")
}

/// Upload-then-attach for requests and messages (LP and Investee service desk).
model RequestAttachment {
  id              String   @id @db.VarChar(20)
  clientId        String?  @map("client_id") @db.Char(36)
  companyId       String?  @map("company_id") @db.Char(36)
  fileId          String   @map("file_id") @db.Char(36)
  name            String   @db.VarChar(255)
  size            Int
  mime            String   @db.VarChar(120)
  sha256          String   @db.Char(64)
  requestId       String?  @map("request_id") @db.Char(36)
  messageId       String?  @map("message_id") @db.Char(36)
  threadMessageId String?  @map("thread_message_id") @db.Char(36)
  uploadedById    String   @map("uploaded_by_id") @db.Char(36)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([clientId])
  @@index([requestId])
  @@index([threadMessageId])
  @@map("request_attachments")
}

// ============================================================ investee (SRD 10.3.4, day-one slice)

model TermSheet {
  id               String    @id @default(uuid()) @db.Char(36)
  ref              String    @unique @db.VarChar(16)
  companyId        String    @map("company_id") @db.Char(36)
  title            String    @db.VarChar(255)
  versionNo        Int       @default(1) @map("version_no")
  /// DRAFT | ISSUED | VIEWED | SIGNED_BY_COMPANY | COUNTERSIGNED | EXECUTED | WITHDRAWN
  status           String    @default("DRAFT") @db.VarChar(20)
  investmentAmount Decimal   @map("investment_amount") @db.Decimal(20, 4)
  valuation        Decimal   @db.Decimal(20, 4)
  equityPercentage Decimal   @map("equity_percentage") @db.Decimal(5, 2)
  currency         String    @default("USD") @db.Char(3)
  keyTerms         Json?     @map("key_terms")
  conditions       String?   @db.Text
  timeline         String?   @db.Text
  documentId       String?   @map("document_id") @db.Char(36)
  createdById      String?   @map("created_by_id") @db.Char(36)
  issuedById       String?   @map("issued_by_id") @db.Char(36)
  approvedById     String?   @map("approved_by_id") @db.Char(36)
  issuedAt         DateTime? @map("issued_at")
  viewedAt         DateTime? @map("viewed_at")
  signedAt         DateTime? @map("signed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  version          Int       @default(1)

  company PortfolioCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@map("term_sheets")
}

// ============================================================ custodian (SRD 10.3.5, day-one slice)

model Counterparty {
  id        String   @id @default(uuid()) @db.Char(36)
  ref       String   @unique @db.VarChar(16)
  name      String   @db.VarChar(200)
  /// CUSTODIAN | BROKER | OTHER
  type      String   @default("CUSTODIAN") @db.VarChar(16)
  /// ACTIVE | SUSPENDED
  status    String   @default("ACTIVE") @db.VarChar(16)
  /// Account references this counterparty may submit for.
  accounts  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users      CounterpartyUser[]
  executions CounterpartyExecution[]
  dayEnds    CounterpartyDayEndPackage[]

  @@map("counterparties")
}

model CounterpartyUser {
  counterpartyId String   @map("counterparty_id") @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  /// submitter | approver
  role           String   @default("submitter") @db.VarChar(16)
  status         String   @default("active") @db.VarChar(16)
  invitedById    String?  @map("invited_by_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at")

  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@id([counterpartyId, userId])
  @@index([userId])
  @@map("counterparty_users")
}

/// Immutable once submitted; a correction is a new row that supersedes the earlier one.
model CounterpartyExecution {
  id              String    @id @default(uuid()) @db.Char(36)
  ref             String    @unique @db.VarChar(20)
  counterpartyId  String    @map("counterparty_id") @db.Char(36)
  tradeRef        String    @map("trade_ref") @db.VarChar(64)
  executionAt     DateTime  @map("execution_at") @db.DateTime(3)
  accountRef      String    @map("account_ref") @db.VarChar(64)
  ticker          String    @db.VarChar(32)
  isin            String?   @db.VarChar(12)
  side            String    @db.VarChar(8)
  quantity        Decimal   @db.Decimal(24, 8)
  price           Decimal   @db.Decimal(20, 8)
  currency        String    @db.Char(3)
  settlementDate  DateTime? @map("settlement_date") @db.Date
  broker          String?   @db.VarChar(120)
  note            String?   @db.Text
  /// Received | Matched | Exception | Queried | Superseded
  status          String    @default("Received") @db.VarChar(16)
  supersedesId    String?   @map("supersedes_id") @db.Char(36)
  supersedeReason String?   @map("supersede_reason") @db.VarChar(255)
  submittedById   String    @map("submitted_by_id") @db.Char(36)
  submittedAt     DateTime  @default(now()) @map("submitted_at")

  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)

  @@unique([counterpartyId, tradeRef])
  @@index([accountRef, executionAt])
  @@map("counterparty_executions")
}

model CounterpartyDayEndPackage {
  id              String    @id @default(uuid()) @db.Char(36)
  ref             String    @unique @db.VarChar(20)
  counterpartyId  String    @map("counterparty_id") @db.Char(36)
  accountRef      String    @map("account_ref") @db.VarChar(64)
  statementDate   DateTime  @map("statement_date") @db.Date
  currency        String    @db.Char(3)
  closingCash     Decimal   @map("closing_cash") @db.Decimal(20, 2)
  holdingsMv      Decimal   @map("holdings_mv") @db.Decimal(20, 2)
  tradeCount      Int       @map("trade_count")
  fileId          String?   @map("file_id") @db.Char(36)
  sha256          String?   @db.Char(64)
  note            String?   @db.Text
  /// Received | Approved | Exception | Superseded
  status          String    @default("Received") @db.VarChar(16)
  supersedesId    String?   @map("supersedes_id") @db.Char(36)
  supersedeReason String?   @map("supersede_reason") @db.VarChar(255)
  submittedById   String    @map("submitted_by_id") @db.Char(36)
  approvedById    String?   @map("approved_by_id") @db.Char(36)
  approvedAt      DateTime? @map("approved_at")
  submittedAt     DateTime  @default(now()) @map("submitted_at")

  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)

  @@index([accountRef, statementDate])
  @@map("counterparty_day_end_packages")
}

// ---------------------------------------------------------------------------
// Portfolio foundation (SRD 10.3: portfolios, securities, prices, positions).
// Read by the staff Orders and Risk modules; written by `modules/portfolio`.
// ---------------------------------------------------------------------------

/// A managed portfolio or mandate (SRD 5.A.2). `mandateJson` holds the limits
/// (maxSingleNamePct, maxSectorPct, cashFloorPct, ...) the pre-trade checks read.
model Portfolio {
  id            String   @id @default(uuid()) @db.Char(36)
  ref           String   @unique @db.VarChar(16)
  name          String   @db.VarChar(160)
  type          String   @db.VarChar(64)
  baseCurrency  String   @default("USD") @map("base_currency") @db.Char(3)
  /// Logical reference to clients.id (no FK, like funds.maker_id).
  clientId      String?  @map("client_id") @db.Char(36)
  /// Logical reference to users.id.
  managerUserId String?  @map("manager_user_id") @db.Char(36)
  benchmark     String?  @db.VarChar(160)
  /// Setup | Active | Suspended | Closed
  status        String   @default("Active") @db.VarChar(16)
  mandateJson   Json?    @map("mandate_json")
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by") @db.Char(36)
  updatedAt     DateTime @updatedAt @map("updated_at")
  updatedBy     String?  @map("updated_by") @db.Char(36)
  version       Int      @default(1)

  positions PortfolioPosition[]
  cash      PortfolioCash[]

  @@index([status])
  @@index([clientId])
  @@index([managerUserId])
  @@index([name])
  @@map("portfolios")
}

/// Tradable instrument master (ZSE, VFEX, OTC).
model Security {
  id         String   @id @default(uuid()) @db.Char(36)
  /// Order-ticket ticker, e.g. DLTA.ZW or ZIM.VX.
  ticker     String   @unique @db.VarChar(24)
  isin       String?  @unique @db.VarChar(12)
  name       String   @db.VarChar(200)
  /// ZSE | VFEX | OTC
  market     String   @db.VarChar(8)
  /// Equity | Fixed income | Cash | Fund | Private
  assetClass String   @default("Equity") @map("asset_class") @db.VarChar(24)
  currency   String   @default("USD") @db.Char(3)
  boardLot   Int      @default(1) @map("board_lot")
  sector     String?  @db.VarChar(80)
  /// Active | Suspended | Delisted
  status     String   @default("Active") @db.VarChar(16)
  /// Average daily traded volume in shares; used by the Orders liquidity check (null = unknown).
  averageDailyVolume Decimal? @map("average_daily_volume") @db.Decimal(24, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  prices    SecurityPrice[]
  positions PortfolioPosition[]

  @@index([market, status])
  @@index([name])
  @@map("securities")
}

model SecurityPrice {
  id         String   @id @default(uuid()) @db.Char(36)
  securityId String   @map("security_id") @db.Char(36)
  priceDate  DateTime @map("price_date") @db.Date
  price      Decimal  @db.Decimal(20, 6)
  /// e.g. ZSE_CLOSE | MANUAL | VENDOR
  source     String   @default("MANUAL") @db.VarChar(24)
  createdBy  String?  @map("created_by") @db.Char(36)
  createdAt  DateTime @default(now()) @map("created_at")

  security Security @relation(fields: [securityId], references: [id], onDelete: Cascade)

  @@unique([securityId, priceDate, source])
  @@index([securityId, priceDate])
  @@map("security_prices")
}

/// Quantity held at an as-of date. The latest row at or before the valuation date is current.
model PortfolioPosition {
  id          String   @id @default(uuid()) @db.Char(36)
  portfolioId String   @map("portfolio_id") @db.Char(36)
  securityId  String   @map("security_id") @db.Char(36)
  quantity    Decimal  @db.Decimal(24, 6)
  avgCost     Decimal  @map("avg_cost") @db.Decimal(20, 6)
  asOf        DateTime @map("as_of") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  security  Security  @relation(fields: [securityId], references: [id])

  @@unique([portfolioId, securityId, asOf])
  @@index([portfolioId, asOf])
  @@index([securityId])
  @@map("positions")
}

/// Simple cash availability per portfolio and currency (source for pre-trade cash checks).
model PortfolioCash {
  id          String   @id @default(uuid()) @db.Char(36)
  portfolioId String   @map("portfolio_id") @db.Char(36)
  currency    String   @db.Char(3)
  available   Decimal  @db.Decimal(20, 4)
  asOf        DateTime @map("as_of") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, currency, asOf])
  @@index([portfolioId, asOf])
  @@map("portfolio_cash")
}

/// Executing brokers for order routing.
model Broker {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @unique @db.VarChar(120)
  email     String?  @db.VarChar(254)
  /// Active | Inactive
  status    String   @default("Active") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("brokers")
}

/// Daily FX rate used to value positions in the portfolio base currency:
/// `rate` converts one unit of `fromCurrency` into `toCurrency`.
model FxRate {
  id           String   @id @default(uuid()) @db.Char(36)
  fromCurrency String   @map("from_currency") @db.Char(3)
  toCurrency   String   @map("to_currency") @db.Char(3)
  rateDate     DateTime @map("rate_date") @db.Date
  rate         Decimal  @db.Decimal(20, 10)
  source       String   @default("MANUAL") @db.VarChar(24)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([fromCurrency, toCurrency, rateDate])
  @@map("fx_rates")
}

// ---- Orders ----
// Order management (SRD 6.6 FR-OMS-*, 7.2). portfolio_id / security_id / broker_id are logical references
// (no foreign keys), like the other staff modules, so this block does not touch the foundation models.

/// A buy or sell order and its lifecycle. Status: Draft | Validated | AwaitingApproval | Approved | Routing |
/// PartiallyFilled | Filled | Settled | Rejected | Cancelled.
model Order {
  id             String    @id @default(uuid()) @db.Char(36)
  ref            String    @unique @db.VarChar(16)
  portfolioId    String    @map("portfolio_id") @db.Char(36)
  securityId     String    @map("security_id") @db.Char(36)
  /// BUY | SELL
  side           String    @db.VarChar(4)
  quantity       Decimal   @db.Decimal(24, 6)
  /// MARKET | LIMIT
  orderType      String    @map("order_type") @db.VarChar(8)
  limitPrice     Decimal?  @map("limit_price") @db.Decimal(20, 6)
  /// DAY | GTC | IOC
  tif            String    @default("DAY") @db.VarChar(8)
  /// Low | Normal | High
  urgency        String    @default("Normal") @db.VarChar(8)
  brokerId       String?   @map("broker_id") @db.Char(36)
  rationale      String?   @db.Text
  /// Security currency (orders are priced and settled in it).
  currency       String    @db.Char(3)
  /// Reference price when the order was made (latest security price).
  decisionPrice  Decimal   @map("decision_price") @db.Decimal(20, 6)
  status         String    @default("Draft") @db.VarChar(24)
  precheckResult Json?     @map("precheck_result")
  precheckAt     DateTime? @map("precheck_at")
  makerId        String    @map("maker_id") @db.Char(36)
  approverId     String?   @map("approver_id") @db.Char(36)
  approvedAt     DateTime? @map("approved_at")
  routerId       String?   @map("router_id") @db.Char(36)
  routedAt       DateTime? @map("routed_at")
  filledQty      Decimal   @default(0) @map("filled_qty") @db.Decimal(24, 6)
  avgPrice       Decimal?  @map("avg_price") @db.Decimal(20, 6)
  /// Buys only: cash held back while the order is open = remaining quantity x reserve_unit.
  reserveUnit    Decimal?  @map("reserve_unit") @db.Decimal(20, 8)
  reservedAmount Decimal   @default(0) @map("reserved_amount") @db.Decimal(20, 4)
  estimatedFee   Decimal   @default(0) @map("estimated_fee") @db.Decimal(20, 4)
  cancelReason   String?   @map("cancel_reason") @db.VarChar(255)
  rejectReason   String?   @map("reject_reason") @db.VarChar(255)
  submittedAt    DateTime? @map("submitted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  version        Int       @default(1)

  fills        OrderFill[]
  instructions BrokerInstruction[]

  @@index([status, createdAt])
  @@index([portfolioId, status])
  @@index([securityId])
  @@index([makerId])
  @@map("orders")
}

model OrderFill {
  id         String   @id @default(uuid()) @db.Char(36)
  orderId    String   @map("order_id") @db.Char(36)
  quantity   Decimal  @db.Decimal(24, 6)
  price      Decimal  @db.Decimal(20, 6)
  fees       Decimal  @default(0) @db.Decimal(20, 4)
  executedAt DateTime @map("executed_at")
  /// MANUAL | FIX | CONTRACT_NOTE
  source     String   @default("MANUAL") @db.VarChar(16)
  sourceRef  String?  @map("source_ref") @db.VarChar(120)
  recordedBy String   @map("recorded_by") @db.Char(36)
  createdAt  DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, executedAt])
  @@map("order_fills")
}

/// The instruction sent to the executing broker when an approved order is routed.
model BrokerInstruction {
  id             String    @id @default(uuid()) @db.Char(36)
  orderId        String    @map("order_id") @db.Char(36)
  brokerId       String    @map("broker_id") @db.Char(36)
  /// EMAIL (FIX is a later channel)
  channel        String    @default("EMAIL") @db.VarChar(8)
  payload        Json
  sentAt         DateTime? @map("sent_at")
  /// QUEUED | SENT | FAILED
  deliveryStatus String    @default("QUEUED") @map("delivery_status") @db.VarChar(12)
  createdBy      String    @map("created_by") @db.Char(36)
  createdAt      DateTime  @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("broker_instructions")
}
// ---- end Orders ----

// ---- Risk ----
// Risk & Compliance (SRD 5.A.7, 6.8 FR-RSK-001..005, BR-001, BR-014). Written by `modules/risk`.
// portfolio_id / scope_id / user ids are logical references (no FK), like the portfolio foundation.

/// A risk limit. DRAFT -> PENDING_APPROVAL -> ACTIVE -> RETIRED; the approver must differ from the maker (BR-001).
model RiskLimit {
  id           String    @id @default(uuid()) @db.Char(36)
  /// LIM-1001 ...
  ref          String    @unique @db.VarChar(16)
  /// SINGLE_NAME_PCT | SECTOR_PCT | CASH_FLOOR_PCT | TOP5_PCT
  metric       String    @db.VarChar(24)
  /// PORTFOLIO | FIRM (FIRM applies to every portfolio)
  scopeType    String    @default("PORTFOLIO") @map("scope_type") @db.VarChar(12)
  /// portfolios.id when scope_type = PORTFOLIO
  scopeId      String?   @map("scope_id") @db.Char(36)
  /// Percent, 0-100 (10 = 10%)
  threshold    Decimal   @db.Decimal(10, 4)
  unit         String    @default("PCT") @db.VarChar(8)
  /// ALERT | ESCALATE | BLOCK
  breachAction String    @default("ALERT") @map("breach_action") @db.VarChar(16)
  description  String?   @db.VarChar(500)
  ownerUserId  String    @map("owner_user_id") @db.Char(36)
  /// DRAFT | PENDING_APPROVAL | ACTIVE | RETIRED
  status       String    @default("DRAFT") @db.VarChar(20)
  makerId      String    @map("maker_id") @db.Char(36)
  checkerId    String?   @map("checker_id") @db.Char(36)
  approvedAt   DateTime? @map("approved_at")
  retiredAt    DateTime? @map("retired_at")
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  breaches RiskBreach[]

  @@index([status])
  @@index([scopeType, scopeId])
  @@map("risk_limits")
}

/// One limit breached by one portfolio on one day; the monitor never records a duplicate.
model RiskBreach {
  id          String    @id @default(uuid()) @db.Char(36)
  limitId     String    @map("limit_id") @db.Char(36)
  portfolioId String    @map("portfolio_id") @db.Char(36)
  detectedOn  DateTime  @map("detected_on") @db.Date
  /// Measured value in percent (for example the largest single-name weight)
  value       Decimal   @db.Decimal(20, 6)
  threshold   Decimal   @db.Decimal(10, 4)
  detail      Json?
  /// OPEN | ACKNOWLEDGED | RESOLVED
  status      String    @default("OPEN") @db.VarChar(16)
  caseId      String?   @map("case_id") @db.Char(36)
  ackBy       String?   @map("ack_by") @db.Char(36)
  ackAt       DateTime? @map("ack_at")
  ackNote     String?   @map("ack_note") @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at")

  limit RiskLimit @relation(fields: [limitId], references: [id])

  @@unique([limitId, portfolioId, detectedOn])
  @@index([status])
  @@index([portfolioId, detectedOn])
  @@map("risk_breaches")
}

/// A saved stress scenario (BR-014). `shocks` = equityPct, fxPct, ratePctPoints, durationYears, redemptionPct.
model RiskScenario {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @unique @db.VarChar(120)
  shocks    Json
  /// liquidity | equity | fx for the built-in presets
  preset    String?  @db.VarChar(16)
  createdBy String?  @map("created_by") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  runs RiskScenarioRun[]

  @@map("risk_scenarios")
}

model RiskScenarioRun {
  id          String   @id @default(uuid()) @db.Char(36)
  scenarioId  String   @map("scenario_id") @db.Char(36)
  portfolioId String   @map("portfolio_id") @db.Char(36)
  asOf        DateTime @map("as_of") @db.Date
  results     Json
  runBy       String?  @map("run_by") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")

  scenario RiskScenario @relation(fields: [scenarioId], references: [id])

  @@index([scenarioId, createdAt])
  @@index([portfolioId, createdAt])
  @@map("risk_scenario_runs")
}

/// A compliance / risk case. Opened by hand or automatically from a breach.
model RiskCase {
  id             String    @id @default(uuid()) @db.Char(36)
  /// RC-1001 ...
  ref            String    @unique @db.VarChar(16)
  type           String    @db.VarChar(40)
  description    String    @db.VarChar(2000)
  /// LOW | MEDIUM | HIGH | CRITICAL
  severity       String    @default("MEDIUM") @db.VarChar(12)
  /// OPEN | INVESTIGATING | RESOLVED | CLOSED
  status         String    @default("OPEN") @db.VarChar(16)
  ownerUserId    String?   @map("owner_user_id") @db.Char(36)
  sourceBreachId String?   @map("source_breach_id") @db.Char(36)
  portfolioId    String?   @map("portfolio_id") @db.Char(36)
  resolutionNote String?   @map("resolution_note") @db.VarChar(2000)
  resolvedAt     DateTime? @map("resolved_at")
  createdBy      String?   @map("created_by") @db.Char(36)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  version        Int       @default(1)

  @@index([status, severity])
  @@index([ownerUserId])
  @@index([sourceBreachId])
  @@map("risk_cases")
}
// ---- end Risk ----

// ---- NAV ----
/// A NAV & valuation run for one portfolio (and optionally the fund it backs) at a date. Each recalculation of the
/// same portfolio + date is a new `version`; only one version per portfolio + date can be RELEASED at a time.
model NavRun {
  id            String    @id @default(uuid()) @db.Char(36)
  /// NAV-00001 ...
  ref           String    @unique @db.VarChar(16)
  portfolioId   String    @map("portfolio_id") @db.Char(36)
  fundId        String?   @map("fund_id") @db.Char(36)
  navDate       DateTime  @map("nav_date") @db.Date
  /// Per portfolio + nav_date, starting at 1.
  version       Int       @default(1)
  /// POSITIONS | CASH | PRICES | FEES | UNITS | MAKER_REVIEW | RELEASE | DONE (derived from state, stored for the stage bar)
  stage         String    @default("PRICES") @db.VarChar(16)
  baseCurrency  String    @default("USD") @map("base_currency") @db.Char(3)
  marketValue   Decimal   @default(0) @map("market_value") @db.Decimal(20, 4)
  cash          Decimal   @default(0) @db.Decimal(20, 4)
  accruals      Decimal   @default(0) @db.Decimal(20, 4)
  fees          Decimal   @default(0) @db.Decimal(20, 4)
  liabilities   Decimal   @default(0) @db.Decimal(20, 4)
  /// Management fee, percent per year; when set, fees = rate / 100 x (market value + cash + accruals) / 365.
  feeRatePct    Decimal?  @map("fee_rate_pct") @db.Decimal(8, 4)
  nav           Decimal   @default(0) @db.Decimal(20, 4)
  units         Decimal?  @db.Decimal(24, 6)
  /// nav / units, 4 dp.
  navPerUnit    Decimal?  @map("nav_per_unit") @db.Decimal(20, 4)
  /// Percent of positions (by value) that carry a price and an FX rate, 4 dp.
  priceCoverage Decimal   @default(100) @map("price_coverage") @db.Decimal(7, 4)
  positionCount Int       @default(0) @map("position_count")
  /// DRAFT | EXCEPTIONS_OPEN | MAKER_REVIEWED | RELEASED | SUPERSEDED
  status        String    @default("DRAFT") @db.VarChar(20)
  /// The preparer (created this version).
  makerId       String    @map("maker_id") @db.Char(36)
  /// The maker review (first control); the releaser must be someone else.
  reviewerId    String?   @map("reviewer_id") @db.Char(36)
  reviewedAt    DateTime? @map("reviewed_at")
  /// The releaser (second control).
  checkerId     String?   @map("checker_id") @db.Char(36)
  releasedAt    DateTime? @map("released_at")
  notes         String?   @db.VarChar(2000)
  /// Cash by currency and the tolerance settings applied to this calculation.
  detail        Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  lines      NavRunLine[]
  exceptions NavException[]

  @@unique([portfolioId, navDate, version])
  @@index([portfolioId, navDate])
  @@index([status])
  @@index([fundId])
  @@map("nav_runs")
}

model NavRunLine {
  id          String    @id @default(uuid()) @db.Char(36)
  runId       String    @map("run_id") @db.Char(36)
  securityId  String    @map("security_id") @db.Char(36)
  ticker      String    @db.VarChar(32)
  name        String    @db.VarChar(200)
  currency    String    @db.Char(3)
  quantity    Decimal   @db.Decimal(24, 6)
  price       Decimal?  @db.Decimal(20, 6)
  priceSource String?   @map("price_source") @db.VarChar(40)
  priceDate   DateTime? @map("price_date") @db.Date
  fxRate      Decimal?  @map("fx_rate") @db.Decimal(20, 10)
  /// quantity x price in the security currency.
  valueLocal  Decimal?  @map("value_local") @db.Decimal(20, 4)
  /// In the portfolio base currency; null when unpriced or no FX.
  valueBase   Decimal?  @map("value_base") @db.Decimal(20, 4)
  /// ["STALE_PRICE", "MISSING_PRICE", "MISSING_FX", "TOLERANCE"]
  flags       Json?

  run NavRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("nav_run_lines")
}

model NavException {
  id             String    @id @default(uuid()) @db.Char(36)
  runId          String    @map("run_id") @db.Char(36)
  /// STALE_PRICE | MISSING_PRICE | MISSING_FX | TOLERANCE | NEGATIVE_CASH
  type           String    @db.VarChar(20)
  securityId     String?   @map("security_id") @db.Char(36)
  ticker         String?   @db.VarChar(32)
  detail         String    @db.VarChar(500)
  currentValue   Decimal?  @map("current_value") @db.Decimal(20, 4)
  referenceValue Decimal?  @map("reference_value") @db.Decimal(20, 4)
  difference     Decimal?  @db.Decimal(20, 4)
  /// A material exception blocks the maker review until it is resolved.
  material       Boolean   @default(false)
  /// OPEN | RESOLVED
  status         String    @default("OPEN") @db.VarChar(12)
  resolution     String?   @db.VarChar(1000)
  evidenceRef    String?   @map("evidence_ref") @db.VarChar(200)
  resolvedBy     String?   @map("resolved_by") @db.Char(36)
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  run NavRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@map("nav_exceptions")
}
// ---- end NAV ----

// ---- Reconciliation ----
/// Counterparty account (as submitted in custodian executions / day-end packages) to internal portfolio.
/// Logical references (no FK), like the portfolio foundation.
model ReconAccountMap {
  id             String   @id @default(uuid()) @db.Char(36)
  counterpartyId String   @map("counterparty_id") @db.Char(36)
  accountRef     String   @map("account_ref") @db.VarChar(64)
  portfolioId    String   @map("portfolio_id") @db.Char(36)
  createdBy      String?  @map("created_by") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([counterpartyId, accountRef])
  @@index([portfolioId])
  @@map("recon_account_map")
}

/// One matching run per family + date + counterparty + portfolio (`scope_key`); a re-run updates the same row.
model ReconRun {
  id             String   @id @default(uuid()) @db.Char(36)
  /// RUN-00001 ...
  ref            String   @unique @db.VarChar(16)
  /// family|date|counterparty or *|portfolio or *
  scopeKey       String   @unique @map("scope_key") @db.VarChar(190)
  /// TRADES | CASH | HOLDINGS | DAYEND_COUNT
  family         String   @db.VarChar(16)
  asOfDate       DateTime @map("as_of_date") @db.Date
  counterpartyId String?  @map("counterparty_id") @db.Char(36)
  portfolioId    String?  @map("portfolio_id") @db.Char(36)
  /// CLEAN | BREAKS | SOURCE_MISSING
  status         String   @default("CLEAN") @db.VarChar(16)
  matchedCount   Int      @default(0) @map("matched_count")
  breakCount     Int      @default(0) @map("break_count")
  /// Tolerances used.
  params         Json?
  /// Missing sources, unmapped accounts.
  summary        Json?
  runCount       Int      @default(1) @map("run_count")
  runBy          String   @map("run_by") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  breaks ReconBreak[]

  @@index([family, asOfDate])
  @@index([counterpartyId])
  @@map("recon_runs")
}

model ReconBreak {
  id             String    @id @default(uuid()) @db.Char(36)
  /// REC-00001 ...
  ref            String    @unique @db.VarChar(16)
  runId          String    @map("run_id") @db.Char(36)
  family         String    @db.VarChar(16)
  itemKey        String    @map("item_key") @db.VarChar(190)
  /// Detected type, e.g. MISSING_INTERNAL, MISSING_EXTERNAL, PRICE_OUT_OF_TOLERANCE, QUANTITY_DIFF, ATTRIBUTE_DIFF, AMOUNT_DIFF
  kind           String    @db.VarChar(32)
  label          String    @db.VarChar(255)
  internalValue  Json?     @map("internal_value")
  externalValue  Json?     @map("external_value")
  /// external - internal (null when one side is missing)
  difference     Decimal?  @db.Decimal(24, 6)
  differencePct  Decimal?  @map("difference_pct") @db.Decimal(14, 4)
  currency       String?   @db.Char(3)
  /// Maker-chosen cause at resolution (TIMING, BOOKING_ERROR, CUSTODIAN_ERROR, PRICE_SOURCE, FX, FEES, CORPORATE_ACTION, OTHER)
  cause          String?   @db.VarChar(32)
  /// LOW | MEDIUM | HIGH | CRITICAL
  severity       String    @db.VarChar(12)
  /// NEW | ASSIGNED | INVESTIGATING | PENDING_CHECKER | MATCHED | CLOSED
  status         String    @default("NEW") @db.VarChar(20)
  ownerUserId    String?   @map("owner_user_id") @db.Char(36)
  counterpartyId String?   @map("counterparty_id") @db.Char(36)
  portfolioId    String?   @map("portfolio_id") @db.Char(36)
  resolutionNote String?   @map("resolution_note") @db.VarChar(2000)
  evidenceRef    String?   @map("evidence_ref") @db.VarChar(255)
  makerId        String?   @map("maker_id") @db.Char(36)
  checkerId      String?   @map("checker_id") @db.Char(36)
  resolvedAt     DateTime? @map("resolved_at")
  closedAt       DateTime? @map("closed_at")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  run    ReconRun          @relation(fields: [runId], references: [id])
  events ReconBreakEvent[]

  @@unique([runId, itemKey])
  @@index([status, severity])
  @@index([family, status])
  @@index([ownerUserId])
  @@index([counterpartyId])
  @@map("recon_breaks")
}

model ReconBreakEvent {
  id         String   @id @default(uuid()) @db.Char(36)
  breakId    String   @map("break_id") @db.Char(36)
  action     String   @db.VarChar(32)
  fromStatus String?  @map("from_status") @db.VarChar(20)
  toStatus   String?  @map("to_status") @db.VarChar(20)
  actorId    String?  @map("actor_id") @db.Char(36)
  note       String?  @db.VarChar(2000)
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  brk ReconBreak @relation(fields: [breakId], references: [id], onDelete: Cascade)

  @@index([breakId, createdAt])
  @@map("recon_break_events")
}

model ReconSignoff {
  id             String   @id @default(uuid()) @db.Char(36)
  /// family|date|counterparty or *
  scopeKey       String   @unique @map("scope_key") @db.VarChar(190)
  family         String   @db.VarChar(16)
  asOfDate       DateTime @map("as_of_date") @db.Date
  counterpartyId String?  @map("counterparty_id") @db.Char(36)
  signedBy       String   @map("signed_by") @db.Char(36)
  signedAt       DateTime @default(now()) @map("signed_at")
  note           String?  @db.VarChar(1000)
  /// Counts at the moment of sign-off.
  summary        Json?

  @@index([family, asOfDate])
  @@map("recon_signoffs")
}
// ---- end Reconciliation ----

// ---- Accounting ----
/// Chart of accounts entry for one entity (a portfolio / the fund it backs). `code` is unique per entity.
model AccAccount {
  id          String   @id @default(uuid()) @db.Char(36)
  portfolioId String   @map("portfolio_id") @db.Char(36)
  code        String   @db.VarChar(20)
  name        String   @db.VarChar(160)
  /// ASSET | LIABILITY | EQUITY | INCOME | EXPENSE (assets and expenses are debit-normal)
  type        String   @db.VarChar(12)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String   @map("created_by") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lines AccJournalLine[]

  @@unique([portfolioId, code])
  @@index([portfolioId, type])
  @@map("acc_accounts")
}

/// A double-entry journal. DRAFT -> PENDING_APPROVAL -> POSTED -> REVERSED (or DISCARDED before posting).
/// Posted journals are immutable; a reversal is a new POSTED journal with the debits and credits swapped.
model AccJournal {
  id            String    @id @default(uuid()) @db.Char(36)
  /// JNL-00001 ...
  ref           String    @unique @db.VarChar(16)
  portfolioId   String    @map("portfolio_id") @db.Char(36)
  entryDate     DateTime  @map("entry_date") @db.Date
  description   String    @db.VarChar(500)
  currency      String    @default("USD") @db.Char(3)
  /// DRAFT | PENDING_APPROVAL | POSTED | REVERSED | DISCARDED
  status        String    @default("DRAFT") @db.VarChar(20)
  totalDebit    Decimal   @default(0) @map("total_debit") @db.Decimal(20, 4)
  totalCredit   Decimal   @default(0) @map("total_credit") @db.Decimal(20, 4)
  makerId       String    @map("maker_id") @db.Char(36)
  submittedAt   DateTime? @map("submitted_at")
  postedBy      String?   @map("posted_by") @db.Char(36)
  postedAt      DateTime? @map("posted_at")
  /// Set on a reversal journal: the journal it reverses.
  reversalOfId  String?   @map("reversal_of_id") @db.Char(36)
  /// Set on the original once reversed: the reversing journal.
  reversedById  String?   @map("reversed_by_id") @db.Char(36)
  reversedAt    DateTime? @map("reversed_at")
  reverseReason String?   @map("reverse_reason") @db.VarChar(500)
  /// System-generated journals only (NAV:<ref>, CA:<ref>:<portfolio>, ORDER:<ref>:SETTLE): at most one journal per source.
  sourceRef     String?   @unique @map("source_ref") @db.VarChar(80)
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  lines AccJournalLine[]

  @@index([portfolioId, entryDate])
  @@index([portfolioId, status])
  @@map("acc_journals")
}

model AccJournalLine {
  id        String  @id @default(uuid()) @db.Char(36)
  journalId String  @map("journal_id") @db.Char(36)
  lineNo    Int     @map("line_no")
  accountId String  @map("account_id") @db.Char(36)
  debit     Decimal @default(0) @db.Decimal(20, 4)
  credit    Decimal @default(0) @db.Decimal(20, 4)
  memo      String? @db.VarChar(255)

  journal AccJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account AccAccount @relation(fields: [accountId], references: [id])

  @@index([journalId])
  @@index([accountId])
  @@map("acc_journal_lines")
}

/// A calendar-month accounting period for one entity. OPEN -> CLOSING -> CLOSED (reopen returns it to OPEN).
model AccPeriod {
  id            String    @id @default(uuid()) @db.Char(36)
  portfolioId   String    @map("portfolio_id") @db.Char(36)
  periodStart   DateTime  @map("period_start") @db.Date
  periodEnd     DateTime  @map("period_end") @db.Date
  /// OPEN | CLOSING | CLOSED
  status        String    @default("OPEN") @db.VarChar(12)
  closingBy     String?   @map("closing_by") @db.Char(36)
  closingAt     DateTime? @map("closing_at")
  closedBy      String?   @map("closed_by") @db.Char(36)
  closedAt      DateTime? @map("closed_at")
  reopenedBy    String?   @map("reopened_by") @db.Char(36)
  reopenedAt    DateTime? @map("reopened_at")
  reopenReason  String?   @map("reopen_reason") @db.VarChar(500)
  /// Checklist and trial-balance totals at the moment of close.
  closeSnapshot Json?     @map("close_snapshot")
  createdBy     String    @map("created_by") @db.Char(36)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([portfolioId, periodEnd])
  @@index([portfolioId, status])
  @@map("acc_periods")
}

// ---- end Accounting ----

// ---- CorporateActions ----
/// A corporate action on one security. ANNOUNCED -> CONFIRMED -> PROCESSED (or CANCELLED before processing).
/// type: CASH_DIVIDEND | STOCK_SPLIT | BONUS_ISSUE | SCRIP_DIVIDEND | RIGHTS_ISSUE | MERGER.
/// `ratioNew : ratioOld` is new shares per old share; `rate` is cash per share (dividend, rights price or merger cash).
model CorpActionEvent {
  id               String    @id @default(uuid()) @db.Char(36)
  /// CA-00001 ...
  ref              String    @unique @db.VarChar(16)
  securityId       String    @map("security_id") @db.Char(36)
  ticker           String    @db.VarChar(24)
  securityName     String    @map("security_name") @db.VarChar(200)
  type             String    @db.VarChar(20)
  /// ANNOUNCED | CONFIRMED | PROCESSED | CANCELLED
  status           String    @default("ANNOUNCED") @db.VarChar(12)
  currency         String    @db.Char(3)
  exDate           DateTime  @map("ex_date") @db.Date
  recordDate       DateTime  @map("record_date") @db.Date
  payDate          DateTime  @map("pay_date") @db.Date
  /// Required for SCRIP_DIVIDEND and RIGHTS_ISSUE; the last day an election can be recorded.
  electionDeadline DateTime? @map("election_deadline") @db.Date
  rate             Decimal?  @db.Decimal(20, 8)
  ratioNew         Decimal?  @map("ratio_new") @db.Decimal(14, 6)
  ratioOld         Decimal?  @map("ratio_old") @db.Decimal(14, 6)
  withholdingPct   Decimal   @default(0) @map("withholding_pct") @db.Decimal(7, 4)
  /// MERGER: the acquirer security that holders receive.
  targetSecurityId String?   @map("target_security_id") @db.Char(36)
  targetTicker     String?   @map("target_ticker") @db.VarChar(24)
  /// Option applied to holders who do not elect by the deadline (CASH | SCRIP | TAKE_UP | LAPSE).
  defaultOption    String?   @map("default_option") @db.VarChar(12)
  description      String?   @db.VarChar(1000)
  /// The creator; the processor must be someone else.
  makerId          String    @map("maker_id") @db.Char(36)
  confirmedBy      String?   @map("confirmed_by") @db.Char(36)
  confirmedAt      DateTime? @map("confirmed_at")
  processedBy      String?   @map("processed_by") @db.Char(36)
  processedAt      DateTime? @map("processed_at")
  cancelledBy      String?   @map("cancelled_by") @db.Char(36)
  cancelledAt      DateTime? @map("cancelled_at")
  cancelReason     String?   @map("cancel_reason") @db.VarChar(1000)
  entitlementsAt   DateTime? @map("entitlements_at")
  /// Processing summary (effect date, cash and share totals).
  detail           Json?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  entitlements CorpActionEntitlement[]

  @@index([status, exDate])
  @@index([securityId, exDate])
  @@map("corp_action_events")
}

/// One portfolio's entitlement, from its position at the record date. `cashAmount` is the net cash effect (negative
/// for a rights subscription); `sharesDelta` the change in the held security; `targetShares` merger shares received.
model CorpActionEntitlement {
  id           String    @id @default(uuid()) @db.Char(36)
  eventId      String    @map("event_id") @db.Char(36)
  portfolioId  String    @map("portfolio_id") @db.Char(36)
  quantity     Decimal   @db.Decimal(24, 6)
  option       String?   @db.VarChar(12)
  elected      Boolean   @default(false)
  electedBy    String?   @map("elected_by") @db.Char(36)
  electedAt    DateTime? @map("elected_at")
  grossAmount  Decimal   @default(0) @map("gross_amount") @db.Decimal(20, 4)
  taxAmount    Decimal   @default(0) @map("tax_amount") @db.Decimal(20, 4)
  cashAmount   Decimal   @default(0) @map("cash_amount") @db.Decimal(20, 4)
  sharesDelta  Decimal   @default(0) @map("shares_delta") @db.Decimal(24, 6)
  targetShares Decimal   @default(0) @map("target_shares") @db.Decimal(24, 6)
  /// PENDING | APPLIED | SKIPPED
  status       String    @default("PENDING") @db.VarChar(10)
  appliedAt    DateTime? @map("applied_at")
  detail       Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  event CorpActionEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, portfolioId])
  @@index([portfolioId])
  @@map("corp_action_entitlements")
}
// ---- end CorporateActions ----
// ---- Cash ----
// Cash & Ledgers (SRD 5.A.15 page `cash`): a double-entry cash sub-ledger per portfolio. Balances are never stored;
// they are derived from posted journal lines. Reservations, expectations and statement imports sit beside it.

/// A ledger account in a portfolio's cash sub-ledger. BANK ledgers hold cash; the others are contra sides.
model CashLedger {
  id            String   @id @default(uuid()) @db.Char(36)
  /// CLG-1001 ...
  ref           String   @unique @db.VarChar(16)
  portfolioId   String   @map("portfolio_id") @db.Char(36)
  name          String   @db.VarChar(160)
  currency      String   @default("USD") @db.Char(3)
  /// BANK | CONTROL | CLEARING | SUSPENSE | EXPENSE
  kind          String   @default("BANK") @db.VarChar(12)
  /// Logical reference to cash_accounts.id (the client bank account this ledger mirrors).
  cashAccountId String?  @map("cash_account_id") @db.Char(36)
  /// Cash kept back from availability.
  minBuffer     Decimal  @default(0) @map("min_buffer") @db.Decimal(20, 4)
  /// Statement-to-ledger variance allowed at close and on import arithmetic.
  tolerance     Decimal  @default(0) @db.Decimal(20, 4)
  /// ACTIVE | SUSPENDED | CLOSED
  status        String   @default("ACTIVE") @db.VarChar(12)
  createdBy     String   @map("created_by") @db.Char(36)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  lines CashJournalLine[]

  @@index([portfolioId, kind])
  @@index([cashAccountId])
  @@map("cash_ledgers")
}

/// A cash journal. DRAFT -> PENDING_APPROVAL -> POSTED -> REVERSED (or REJECTED / DISCARDED before posting).
/// Posted journals are immutable; a reversal is a new POSTED journal with the sides swapped.
model CashJournal {
  id            String    @id @default(uuid()) @db.Char(36)
  /// CJ-00001 ...
  ref           String    @unique @db.VarChar(16)
  portfolioId   String    @map("portfolio_id") @db.Char(36)
  entryDate     DateTime  @map("entry_date") @db.Date
  description   String    @db.VarChar(500)
  /// BUY_SETTLEMENT | CLIENT_DEPOSIT | CLIENT_WITHDRAWAL | EXTERNAL_FEE | TRANSFER | MANUAL_CORRECTION | REVERSAL
  purpose       String    @default("MANUAL_CORRECTION") @db.VarChar(24)
  sourceRef     String?   @map("source_ref") @db.VarChar(80)
  evidenceRef   String?   @map("evidence_ref") @db.VarChar(120)
  currency      String    @default("USD") @db.Char(3)
  /// DRAFT | PENDING_APPROVAL | POSTED | REVERSED | REJECTED | DISCARDED
  status        String    @default("DRAFT") @db.VarChar(20)
  totalDebit    Decimal   @default(0) @map("total_debit") @db.Decimal(20, 4)
  totalCredit   Decimal   @default(0) @map("total_credit") @db.Decimal(20, 4)
  makerId       String    @map("maker_id") @db.Char(36)
  submittedAt   DateTime? @map("submitted_at")
  postedBy      String?   @map("posted_by") @db.Char(36)
  postedAt      DateTime? @map("posted_at")
  rejectReason  String?   @map("reject_reason") @db.VarChar(500)
  /// Settles this expectation when the journal posts.
  expectationId String?   @map("expectation_id") @db.Char(36)
  /// Consumes this reservation (by the cash credited) when the journal posts.
  reservationId String?   @map("reservation_id") @db.Char(36)
  reversalOfId  String?   @map("reversal_of_id") @db.Char(36)
  reversedById  String?   @map("reversed_by_id") @db.Char(36)
  reversedAt    DateTime? @map("reversed_at")
  reverseReason String?   @map("reverse_reason") @db.VarChar(500)
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  lines CashJournalLine[]

  @@index([portfolioId, entryDate])
  @@index([portfolioId, status])
  @@map("cash_journals")
}

model CashJournalLine {
  id        String  @id @default(uuid()) @db.Char(36)
  journalId String  @map("journal_id") @db.Char(36)
  lineNo    Int     @map("line_no")
  ledgerId  String  @map("ledger_id") @db.Char(36)
  debit     Decimal @default(0) @db.Decimal(20, 4)
  credit    Decimal @default(0) @db.Decimal(20, 4)
  memo      String? @db.VarChar(255)

  journal CashJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  ledger  CashLedger  @relation(fields: [ledgerId], references: [id])

  @@index([journalId])
  @@index([ledgerId])
  @@map("cash_journal_lines")
}

/// Cash held back for an order, withdrawal or transfer. Reduces availability without changing posted cash.
model CashReservation {
  id            String    @id @default(uuid()) @db.Char(36)
  /// RSV-1001 ...
  ref           String    @unique @db.VarChar(16)
  portfolioId   String    @map("portfolio_id") @db.Char(36)
  ledgerId      String    @map("ledger_id") @db.Char(36)
  /// Logical reference to orders.id when the hold backs an order.
  orderId       String?   @map("order_id") @db.Char(36)
  source        String    @db.VarChar(80)
  /// BUY_SETTLEMENT | WITHDRAWAL | TRANSFER
  purpose       String    @default("BUY_SETTLEMENT") @db.VarChar(20)
  currency      String    @db.Char(3)
  amount        Decimal   @db.Decimal(20, 4)
  consumed      Decimal   @default(0) @db.Decimal(20, 4)
  requiredDate  DateTime  @map("required_date") @db.Date
  expiresOn     DateTime? @map("expires_on") @db.Date
  /// ACTIVE | PARTIALLY_CONSUMED | CONSUMED | RELEASED | EXPIRED
  status        String    @default("ACTIVE") @db.VarChar(20)
  createdBy     String    @map("created_by") @db.Char(36)
  releasedBy    String?   @map("released_by") @db.Char(36)
  releasedAt    DateTime? @map("released_at")
  releaseReason String?   @map("release_reason") @db.VarChar(500)
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([portfolioId, status])
  @@index([ledgerId, status])
  @@index([orderId])
  @@map("cash_reservations")
}

/// A forecast cash movement. Projection only: it never changes availability. EXPECTED -> DUE -> POSTED.
model CashExpectation {
  id           String   @id @default(uuid()) @db.Char(36)
  /// EXP-1001 ...
  ref          String   @unique @db.VarChar(16)
  portfolioId  String   @map("portfolio_id") @db.Char(36)
  ledgerId     String   @map("ledger_id") @db.Char(36)
  /// IN | OUT
  direction    String   @db.VarChar(3)
  /// SETTLEMENT | DIVIDEND | CAPITAL_CALL | DISTRIBUTION | FEE | OTHER
  kind         String   @default("OTHER") @db.VarChar(16)
  source       String?  @db.VarChar(80)
  currency     String   @db.Char(3)
  amount       Decimal  @db.Decimal(20, 4)
  expectedDate DateTime @map("expected_date") @db.Date
  /// EXPECTED | DUE | POSTED | CANCELLED
  status       String   @default("EXPECTED") @db.VarChar(12)
  journalId    String?  @map("journal_id") @db.Char(36)
  note         String?  @db.VarChar(500)
  createdBy    String   @map("created_by") @db.Char(36)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([portfolioId, status])
  @@index([ledgerId, expectedDate])
  @@map("cash_expectations")
}

/// A bank statement staged for review. STAGED -> COMMITTED by a checker other than the uploader (or REJECTED).
model CashStatementImport {
  id             String    @id @default(uuid()) @db.Char(36)
  /// IMP-1001 ...
  ref            String    @unique @db.VarChar(16)
  ledgerId       String    @map("ledger_id") @db.Char(36)
  portfolioId    String    @map("portfolio_id") @db.Char(36)
  filename       String    @db.VarChar(200)
  /// SHA-256 of the uploaded content; a repeat on the same ledger is refused.
  fileHash       String    @map("file_hash") @db.Char(64)
  /// CSV | JSON
  format         String    @db.VarChar(8)
  statementFrom  DateTime  @map("statement_from") @db.Date
  statementTo    DateTime  @map("statement_to") @db.Date
  openingBalance Decimal   @map("opening_balance") @db.Decimal(20, 4)
  closingBalance Decimal   @map("closing_balance") @db.Decimal(20, 4)
  lineCount      Int       @map("line_count")
  /// opening + sum(lines) - closing; must be within the ledger tolerance to stage.
  variance       Decimal   @db.Decimal(20, 4)
  /// STAGED | COMMITTED | REJECTED
  status         String    @default("STAGED") @db.VarChar(12)
  makerId        String    @map("maker_id") @db.Char(36)
  checkerId      String?   @map("checker_id") @db.Char(36)
  committedAt    DateTime? @map("committed_at")
  rejectReason   String?   @map("reject_reason") @db.VarChar(500)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  lines CashStatementLine[]

  @@unique([ledgerId, fileHash])
  @@index([portfolioId, status])
  @@index([ledgerId, statementTo])
  @@map("cash_statement_imports")
}

model CashStatementLine {
  id               String    @id @default(uuid()) @db.Char(36)
  importId         String    @map("import_id") @db.Char(36)
  ledgerId         String    @map("ledger_id") @db.Char(36)
  lineNo           Int       @map("line_no")
  valueDate        DateTime  @map("value_date") @db.Date
  /// Signed from the fund's view: positive = cash in.
  amount           Decimal   @db.Decimal(20, 4)
  reference        String?   @db.VarChar(120)
  description      String?   @db.VarChar(255)
  /// SHA-256 of ledger, date, amount, reference and description; repeats are refused.
  fingerprint      String    @db.Char(64)
  /// UNMATCHED | MATCHED | IGNORED
  status           String    @default("UNMATCHED") @db.VarChar(12)
  matchedJournalId String?   @map("matched_journal_id") @db.Char(36)
  matchedAt        DateTime? @map("matched_at")
  note             String?   @db.VarChar(255)

  import CashStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@index([ledgerId, fingerprint])
  @@index([ledgerId, status, valueDate])
  @@map("cash_statement_lines")
}

/// Month-end (or any date) cash close for a portfolio. PREPARED -> APPROVED (independent checker) -> CLOSED.
model CashPeriodClose {
  id            String    @id @default(uuid()) @db.Char(36)
  portfolioId   String    @map("portfolio_id") @db.Char(36)
  periodEnd     DateTime  @map("period_end") @db.Date
  /// PREPARED | APPROVED | CLOSED
  status        String    @default("PREPARED") @db.VarChar(12)
  preparedBy    String    @map("prepared_by") @db.Char(36)
  preparedAt    DateTime  @default(now()) @map("prepared_at")
  approvedBy    String?   @map("approved_by") @db.Char(36)
  approvedAt    DateTime? @map("approved_at")
  closedBy      String?   @map("closed_by") @db.Char(36)
  closedAt      DateTime? @map("closed_at")
  reopenedBy    String?   @map("reopened_by") @db.Char(36)
  reopenedAt    DateTime? @map("reopened_at")
  reopenReason  String?   @map("reopen_reason") @db.VarChar(500)
  /// Pre-check result at the moment of close.
  closeSnapshot Json?     @map("close_snapshot")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([portfolioId, periodEnd])
  @@index([portfolioId, status])
  @@map("cash_period_closes")
}

// ---- end Cash ----

// ---- Wiring ----
/// Operations Control runbook task (SRD 5.A.16 page `operations`). Generated tasks carry a unique `sourceRef`
/// (e.g. RECON:BREAKS, CA:<ref>:JOURNALS) so refreshing the runbook never duplicates them.
/// area: SETTLEMENT | CASH | CORPORATE_ACTIONS | VALUATION | CLOSE | REPORTING | RISK | OTHER.
/// status: OPEN | IN_PROGRESS | BLOCKED | DONE | CANCELLED.
model OpsTask {
  id            String    @id @default(uuid()) @db.Char(36)
  /// OPT-0001 ...
  ref           String    @unique @db.VarChar(16)
  area          String    @db.VarChar(20)
  title         String    @db.VarChar(200)
  detail        String?   @db.VarChar(1000)
  dueAt         DateTime  @map("due_at")
  status        String    @default("OPEN") @db.VarChar(12)
  ownerId       String?   @map("owner_id") @db.Char(36)
  dependsOnId   String?   @map("depends_on_id") @db.Char(36)
  blockedReason String?   @map("blocked_reason") @db.VarChar(500)
  link          String?   @db.VarChar(300)
  sourceRef     String?   @unique @map("source_ref") @db.VarChar(80)
  createdBy     String    @map("created_by") @db.Char(36)
  completedBy   String?   @map("completed_by") @db.Char(36)
  completedAt   DateTime? @map("completed_at")
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, dueAt])
  @@index([area, status])
  @@map("ops_tasks")
}
// ---- end Wiring ----
