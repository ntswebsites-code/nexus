{
  "name": "@matanho/api",
  "version": "1.0.0",
  "private": true,
  "description": "Shared Express API for every Matanho Nexus portal (auth foundation + health).",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "prisma generate --schema prisma/schema.prisma && tsup",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:validate": "dotenv -e ../../.env -- prisma validate --schema prisma/schema.prisma",
    "test:offline": "tsx scripts/offline-rules.ts && tsx scripts/test-admin-core.ts && tsx scripts/test-clients-onboarding.ts && tsx scripts/test-admin-platform.ts && tsx scripts/offline-investee-deals.ts",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy --schema prisma/schema.prisma",
    "db:status": "dotenv -e ../../.env -- prisma migrate status --schema prisma/schema.prisma",
    "db:seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio --schema prisma/schema.prisma",
    "smoke": "tsx --env-file-if-exists=../../.env scripts/smoke-auth.ts",
    "e2e": "tsx --env-file-if-exists=../../.env scripts/e2e-phase1.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@matanho/shared": "*",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.19.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
